Cell[CellGroupData[{

Cell["Example (5.5)", "Subsection",
 CellChangeTimes->{{4.0018424635146627`*^9, 
  4.001842469458257*^9}},ExpressionUUID->"cdf9ee97-22b6-4302-9e20-\
a7b0cc7a98ed"],

Cell[TextData[{
 "Consider the curve E : ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9ef3794d-fc70-4eeb-bcfe-540393af79e9"],
 " + y \[Minus]xy = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f8b5c946-413b-48a6-894a-78605e561433"],
 ", (1, 1) generates a subgroup of order 6 in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"E", "(", "Q", ")"}], "tors"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d9030286-5d63-49cf-bc3e-943448529f20"],
 ". Reducing this curve mod\n2, to see that the curve is isomorphic to ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b63240df-f304-47a7-83e1-227a2d2b215b"],
 "+xy = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "3"], "+", 
    SuperscriptBox["x", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2a5f0bb4-52f8-4652-9311-3e7e2f6ebdb6"],
 " over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "79d3df04-d6ae-4771-b112-f10de46f9efb"],
 " which is singular. Hence it has bad reduction at 2. Modulo 3 the situation \
is better."
}], "Text",
 CellChangeTimes->{{4.00184251509828*^9, 4.0018426168844786`*^9}, {
  4.001842647948938*^9, 
  4.0018426636581225`*^9}},ExpressionUUID->"d9ed3097-24d1-4f32-a8c5-\
