Cell[CellGroupData[{

Cell["Exercise 6", "Subsubsection",
 CellChangeTimes->{{4.0018422039645123`*^9, 
  4.0018422098531685`*^9}},ExpressionUUID->"97d9f6b9-f091-420d-8384-\
295a371093c9"],

Cell[TextData[{
 "Find the discriminant of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ef585ca-fbc4-4c98-b93e-465f0b565c04"],
 " + y = ",
