  RowBox[{"{", 
   RowBox[{"0", ",", "0", ",", "1", ",", 
    RowBox[{"-", "7"}], ",", "6"}], "}"}], "]"}]], "Input",
 CellChangeTimes->{{4.001842255010475*^9, 4.001842277309708*^9}, {
  4.00233589352561*^9, 4.002335893941175*^9}},
 CellLabel->
  "In[228]:=",ExpressionUUID->"8c729291-416a-4cb9-bfa9-34778bcbe03b"],

Cell[BoxData["5077"], "Output",
