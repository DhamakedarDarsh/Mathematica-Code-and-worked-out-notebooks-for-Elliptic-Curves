Cell[TextData[{
 "For the elliptic curve E : ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7495e900-d021-4988-84f6-7fe7963ff40c"],
 " \[Minus] y = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e0836219-5a73-4bfe-b8fa-2890643f9c71"],
 " \[Minus] 7, show that E is nonsingular mod 2. Show that E(Q) has no point \
of order 2, and deduce that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"E", "(", "Q", ")"}], "tors"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "734793ee-cb6a-412a-ab0f-7e80d207aab1"],
 " is cyclic of order 3."
}], "Text",
