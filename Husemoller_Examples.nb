  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "701bc067-d3e2-4638-ae03-626e7ea0f377"],
 " \[Minus] 7x + 6 and show that it is a prime."
}], "Text",
 CellChangeTimes->{{4.0018422344841413`*^9, 
  4.0018422455119133`*^9}},ExpressionUUID->"b272bdd3-2c79-43d8-af26-\
f35468ad40d6"],

