   SuperscriptBox["y", "2"], "-", 
   RowBox[{"x", "*", 
    RowBox[{"(", 
     RowBox[{"x", "-", "1"}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{"x", "+", "9"}], ")"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.999240284597048*^9, 3.999240289307645*^9}, {
  3.999735459202895*^9, 3.999735460056691*^9}, {3.9997355169715033`*^9, 
  3.9997355288339767`*^9}, {4.002076783381753*^9, 4.002076797778079*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"f1bb98c1-1e86-49a5-9fd0-547f62d198c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"9", " ", "x"}], "-", 
  RowBox[{"8", " ", 
   SuperscriptBox["x", "2"]}], "-", 
  SuperscriptBox["x", "3"], "+", 
  SuperscriptBox["y", "2"]}]], "Output",
 CellChangeTimes->{4.002076799539542*^9, 4.0023338164746857`*^9, 
  4.0023388085348463`*^9, 4.002345601400825*^9, 4.0034673406404667`*^9},
 CellLabel->"Out[57]=",ExpressionUUID->"3f54ca9b-9f1b-479c-8c02-3a3593902329"]
}, Open  ]],

