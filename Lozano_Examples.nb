Cell[CellGroupData[{

Cell["Example 2.7.7.", "Subsection",
 CellChangeTimes->{{4.001393196319665*^9, 
  4.0013932131197443`*^9}},ExpressionUUID->"5f485117-bfef-4f10-89f4-\
c1a2f98be8c4"],

Cell[TextData[{
 "Let E/Q be the elliptic curve ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "a9657a89-d386-4487-8d5b-243bea25f642"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "cfc13be7-cb87-4276-b623-9051690825ef"],
 " + ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2308", 
    SuperscriptBox["x", "2"]}], TraditionalForm]],ExpressionUUID->
  "faf798e3-9b9a-49e9-8507-b6f70e3f9864"],
 " +665858x. Put P = (\[Minus]1681, 25543) , Q = (\[Minus]338, 26), and  R = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    FractionBox["332929", "36"]}], TraditionalForm]],ExpressionUUID->
  "1ee7a6f1-e369-4b2c-8d12-9e28bff6e765"],
 ", ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"-", "215405063"}], "216"], TraditionalForm]],ExpressionUUID->
  "c7550cc7-1c0e-4247-b0bc-7ddc63f0784b"],
 "). Are P , Q and R independent?"
}], "Text",
 CellChangeTimes->{{4.0013932554522743`*^9, 4.00139330312939*^9}, {
  4.0013935045617*^9, 
  4.001393580394121*^9}},ExpressionUUID->"b3c0667d-4fa0-4a0f-a7f4-\
00cf75090f61"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ECPIndependentQ", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
