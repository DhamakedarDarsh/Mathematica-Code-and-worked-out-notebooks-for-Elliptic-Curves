     RowBox[{"(", 
      RowBox[{"x", "+", "5"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{"x", "+", "10"}], ")"}]}]}],
   TraditionalForm], "]"}]], "Input",
