  FormBox[
   SuperscriptBox["5", "12"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "50e987b9-e458-4b2b-87ab-599727530e44"],
 " and the curve ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b8bc93c5-4cfc-4d19-b394-82a8bb25762c"],
 " : ",
