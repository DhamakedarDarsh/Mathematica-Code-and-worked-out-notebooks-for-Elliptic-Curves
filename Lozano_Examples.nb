Cell[CellGroupData[{

Cell["Example 2.6.6.", "Subsection",
 CellChangeTimes->{{3.981185611362062*^9, 
  3.9811856218373203`*^9}},ExpressionUUID->"c49babce-50a2-4bdb-899d-\
4621b41a137f"],

Cell[TextData[{
 "Let E/Q be the elliptic curve ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bb28cb49-36d7-4587-86a1-cfd8029f0b3d"],
 "= x(x + 1)(x + 2) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1e27d3e7-798e-4314-ba8d-270ba0913450"],
 " + ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", 
    SuperscriptBox["x", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5679e17d-7d7f-4613-9a7c-63e6de101641"],
 " + 2x. The reader can check that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"E", "(", "Q", ")"}], "torsion"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "794b5bd3-6164-42a2-9b05-d04bc8747a4d"],
 " = {O, (0, 0), (\[Minus]1, 0), (\[Minus]2, 0)}."
}], "Text",
 CellChangeTimes->{{3.9811856872004013`*^9, 
  3.9811857602075233`*^9}},ExpressionUUID->"08f2ccbc-af68-41f1-a204-\
ee1c5c822f97"],

Cell[CellGroupData[{

Cell[BoxData[
