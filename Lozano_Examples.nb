  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3cea930b-b4da-4ea1-a010-4ecead0cf39f"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a0497da9-8e0a-40d4-92e6-69711227636b"],
 " + 1 has discriminant ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Laplacian]", 
    SubscriptBox["E", "0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0139d111-3c81-410c-8635-75605c4f7936"],
 " = ",
