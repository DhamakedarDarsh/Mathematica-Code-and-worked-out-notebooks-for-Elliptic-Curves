   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1e31c504-80dd-4f21-b040-1e4f1fcbee7b"],
 " + 3. Its minimal discriminant is \[Laplacian]E = \[Minus]3888 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Minus]", 
    SuperscriptBox["2", "4"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1e836914-c070-441d-936b-9ae149cf5718"],
