   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e2ce9227-fc79-4be2-a345-2b212154d9fc"],
 " + 56 has discriminant \[Laplacian]E = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Minus]", 
    SuperscriptBox["2", "4"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6ee80b09-e901-4a8e-8151-d3b0504e41d9"],
 " ",
