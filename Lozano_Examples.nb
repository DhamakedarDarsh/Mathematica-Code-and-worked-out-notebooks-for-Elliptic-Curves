Cell[TextData[{
 "(4) The elliptic curve ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1f23aa8a-12d8-4c68-a9a2-cd2fc55047ec"],
 "/Q : ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "9cc1bf42-26dc-4c3d-adde-41ce8e54d093"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "9034b561-b3c7-4116-8678-76a3c303f0e4"],
 " + ",
 Cell[BoxData[
  FormBox[
   RowBox[{"7105", 
    SuperscriptBox["x", "2"]}], TraditionalForm]],ExpressionUUID->
  "6fbe23b8-ed3a-4d7d-be74-9dbd84d9e1ef"],
 " + 1327104x, features both torsion and infinite order points. In fact,\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cc82acbb-9ca6-40e4-863c-cf6b3d3ecb16"],
 " (Q) \[TildeFullEqual] Z/4Z \[CirclePlus] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Z", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "95a8e15c-fd28-45ef-a4d7-543b961843b0"],
 ". The torsion subgroup is generated by the point T = (1152, 111744) of \
order 4. The free part is generated by three points of infinite order:\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]],ExpressionUUID->
  "359b63dc-8263-4be2-921e-7cafd4573e8d"],
 "= (\[Minus]6912, 6912), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "2"], TraditionalForm]],ExpressionUUID->
  "4417ceba-53e7-4c43-ab02-3729ee06a2f2"],
 " = (\[Minus]5832, 188568), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "3"], TraditionalForm]],ExpressionUUID->
  "94f4bce1-9efc-4a02-bebd-ecf058891201"],
 " = (\[Minus]5400, 206280)."
}], "Text",
 CellChangeTimes->{{3.9802086642599792`*^9, 3.9802087222161694`*^9}, {
   3.980208762530324*^9, 3.980208784191091*^9}, {3.980209590893695*^9, 
