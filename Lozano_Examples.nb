Cell[TextData[{
 "(3) The curve ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dfbf89bf-420a-4dc5-adbb-ba4e44a76489"],
 "/Q : ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c27f67a2-1360-4c67-a2e3-6e055cf4e847"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "475bf87c-1dba-4483-9927-ef3e8a87d86b"],
 " \[Minus] 2 does not have any rational torsion points other than O. \
However, the point P = (3, 5) is a rational point. Thus, P must be a point of \
infinite order and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e76dced2-cf8f-4a63-9cc6-7566fa73c1d1"],
 "(Q) contains infinitely many distinct rational points. In fact, the rank of \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5ca5db06-e01a-40d2-8566-3d782e044b7e"],
 " is equal to 1 and P is a generator of all of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0ff868d4-264e-4b29-9195-1f084e8d1029"],
 "(Q)."
}], "Text",
 CellChangeTimes->{{4.002341699201662*^9, 
  4.002341797323601*^9}},ExpressionUUID->"6941f264-9473-47e4-b159-\
f3d26074b074"],

