Cell["Example 2.3.1. ", "Subsection",
 CellChangeTimes->{{3.97427319168233*^9, 3.974273232723076*^9}, {
   3.974768080312436*^9, 3.9747680829903917`*^9}, {3.97988973605832*^9, 
