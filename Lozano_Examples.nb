Cell["Example 2.3.7.", "Subsection",
 CellChangeTimes->{{3.9802083343197117`*^9, 3.9802083398871613`*^9}, 
   3.9802085887192383`*^9, 
   3.9802106279961367`*^9},ExpressionUUID->"438baf1d-48bd-45b2-ac7c-\
6b0d97931ec0"],

Cell[TextData[{
 "(1) The curve ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "86b729c2-10d8-4a21-b554-fcda1b35c6ea"],
 "/Q : ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "be40821e-38a0-4efd-92dd-3e3ed7f0a7b7"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7b03142f-e121-47c4-b7e1-a9d6509d7244"],
 " + 6 has no rational points, other than the point at infinity O. Therefore, \
there are no torsion points (other than O) and no points of infinite order. \
In particular, the rank is 0, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "75fa81fa-6f5e-4e52-bcac-b45bb03b2b76"],
 "(Q) = {O}."
}], "Text",
 CellChangeTimes->{{4.002342191064753*^9, 
  4.002342235930492*^9}},ExpressionUUID->"4c2425c3-ea16-4ed6-bd2f-\
e2f08c465864"],

