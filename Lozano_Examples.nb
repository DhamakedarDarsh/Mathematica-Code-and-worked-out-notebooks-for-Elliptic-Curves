Cell[CellGroupData[{

Cell["Example 2.4.3.", "Subsection",
 CellChangeTimes->{{3.980210699725307*^9, 
  3.9802107173009233`*^9}},ExpressionUUID->"2ee927e8-0e00-4807-822a-\
5cf837894dbe"],

Cell[TextData[{
 "The torsion subgroup of the elliptic curve with Weierstrass equation ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "1205afe3-6e29-45de-9c89-08994da809b6"],
 " + 43xy \[Minus] 210y = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "059c1a40-d11d-416c-9d6f-84b26ce534eb"],
 " \[Minus] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"210", 
    SuperscriptBox["x", "2"]}], TraditionalForm]],ExpressionUUID->
  "b56f484c-bafe-4a47-af2f-c7aca7f26983"],
 " is isomorphic to Z/12Z and it is generated by the point (0, 210). The \
elliptic curve ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "1cbecfc5-2e6a-4153-9f9b-09e2d98a5bcd"],
 " + 17xy \[Minus] 120y = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "009e1649-7d2c-4b14-ac25-70ea28e245d9"],
 " \[Minus] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"60", 
    SuperscriptBox["x", "2"]}], TraditionalForm]],ExpressionUUID->
  "6e8649a9-7238-4049-967c-b495289237ef"],
 " has a torsion subgroup\nisomorphic to Z/2Z\[CirclePlus]Z/8Z, generated by \
the rational points (30, \[Minus]90) and (\[Minus]40, 400)."
}], "Text",
 CellChangeTimes->{{3.980210789113409*^9, 3.9802108759714603`*^9}, 
   3.980211341228981*^9, {4.002342544527788*^9, 4.002342550549883*^9}, {
   4.002342588032763*^9, 
   4.0023425941100817`*^9}},ExpressionUUID->"33a053ee-a030-42d2-8bfa-\
996a105b17ad"],

