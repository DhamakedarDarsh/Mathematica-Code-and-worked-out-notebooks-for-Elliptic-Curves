Cell[CellGroupData[{

Cell["Example 2.4.7.", "Subsection",
 CellChangeTimes->{{3.9811826502639313`*^9, 3.9811826630168467`*^9}, {
  3.9811828986816063`*^9, 
  3.9811828989551764`*^9}},ExpressionUUID->"faeeb909-0c5a-4a45-9dc6-\
d4e03b42d85f"],

Cell[TextData[{
 "Let p \[GreaterEqual] 2 be a prime number and let us define a curve ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "P"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "260bcafc-88a4-4421-9641-58130e0c447f"],
 " : ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a4c12ece-7188-4f00-a5f0-1bfd0e96c08e"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d77c5754-d3cd-4ead-8f6a-02ba79a9ba87"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["p", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "91ede7a1-56d8-4b49-8a5f-88c933b074ed"],
 " . Since ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fdcf7562-0e02-40e2-a2ce-2da8deb99ead"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["p", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "08c37799-c965-4e49-bf09-0da1a84213c8"],
 " = 0 does not have any rational roots, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "P"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "45299660-4603-4eb3-8151-502540ebfa6a"],
 "(Q) does not contain points of order 2. Let P be a torsion point on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "P"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8d39c785-8ec8-44df-ba7a-1a8f588faedc"],
 "(Q). The list of all squares dividing ",
 Cell[BoxData[
  FormBox[
   RowBox[{"4", 
    SuperscriptBox["A", "3"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e523fe12-65a2-4bb0-977e-643a5974422a"],
 "+ ",
 Cell[BoxData[
  FormBox[
   RowBox[{"27", 
    SuperscriptBox["B", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8581a18e-0d9c-40ec-9ca3-d42a531014eb"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"27", 
    SuperscriptBox["p", "4"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "442a7538-d76d-4f8c-8047-a278ace679e8"],
 " is short, and by the Nagell-Lutz theorem the possible values for y(P ) \
are:\ny = \[PlusMinus]1, \[PlusMinus]p, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox["p", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9ae059e4-f39d-4c5d-a2f9-fa085164dc15"],
 " , \[PlusMinus]3p, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", "3"}], 
    SuperscriptBox["p", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f4bf3a8e-038a-43eb-afe7-a9adb4ef9fad"],
 " , and \[PlusMinus] 3.\nClearly, (0, \[PlusMinus]p) \[Element] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "P"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4828f48e-c992-4817-a4af-b5df84c72947"],
 " (Q) and one can show that those two points and O are the only torsion \
points. Thus, the torsion subgroup of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "P"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "860e47ab-5f42-4a8f-926f-66c8638e95a8"],
 "(Q) is isomorphic to Z/3Z, for any prime p \[GreaterEqual] 2.\nLet p=2 :"
}], "Text",
 CellChangeTimes->{{3.9811829342534657`*^9, 3.981182978355748*^9}, {
  3.9811830160208178`*^9, 3.981183284807259*^9}, {3.9811836539529257`*^9, 
  3.981183661517411*^9}},ExpressionUUID->"441e58f2-0eea-4c5f-97ee-\
8d1f13a021d5"],

