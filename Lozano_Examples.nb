Cell[CellGroupData[{

Cell["Example 2.6.5.", "Subsection",
 CellChangeTimes->{
  3.981185430978017*^9},ExpressionUUID->"9d1bf9ac-adeb-48c7-8d49-\
186114f55bcc"],

Cell[TextData[{
 "let us show that the curve ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "01e55920-9d4c-4779-afe0-baf5103ce0a4"],
 " : ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c99a9527-8187-4731-9a0a-4feab6101281"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bb78fec5-c5a8-4e7d-8bb4-dd9c62e2b66c"],
 " \[Minus] x = x(x \[Minus] 1)(x + 1) only has the trivial solutions (0, 0), \
(\[PlusMinus]1, 0) which are torsion points of order 2. Indeed, the minimal \
discriminant of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f651525a-152c-4342-888a-caea9061bcc1"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Laplacian]", 
    SubscriptBox["E", "1"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f86639d5-69be-4ef7-aa3e-f95ea6bb42ad"],
 " = 64."
}], "Text",
 CellChangeTimes->{{3.9811854676270943`*^9, 3.9811854982738132`*^9}, {
  3.9811855595087767`*^9, 
  3.981185570963437*^9}},ExpressionUUID->"caf5fa82-16e1-4857-90db-\
dfe99152f076"],

