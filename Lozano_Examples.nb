Cell[CellGroupData[{

Cell["Example 2.7.3.", "Subsection",
 CellChangeTimes->{
  3.98118733502567*^9},ExpressionUUID->"08003b7c-47da-4c0b-b60e-778f3e24b284"],

Cell[TextData[{
 "Let E/Q : ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "1fde4f12-f7ba-4afa-9a48-8d718a2b4305"],
 " + y = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "2605254d-d54d-4694-8b4c-7bbc40a7330e"],
 "\[Minus] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "3b1d31a0-c309-4884-a709-14bde3db05f3"],
 " \[Minus] 26790x + 1696662 and put ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "1"], "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"59584", "/", "625"}], ",", 
      RowBox[{"71573", "/", "15625"}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"d7697c40-1f33-41e0-b89b-bc4e5bcac24e"],
 " , ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "2"], "=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"101307506181", "/", "210337009"}], ",", 
      RowBox[{"30548385002405573", "/", "3050517641527"}]}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"10d6978f-19ba-45e3-9a6c-64b8e82dbe26"],
 ". The points ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "1"], TraditionalForm]],ExpressionUUID->
  "62e03299-ab03-460a-af36-ead578c519db"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "2"], TraditionalForm]],ExpressionUUID->
  "0ea90487-8f91-4271-85ab-8592352d1f15"],
 " are rational points on E, and they are linearly dependent over Z because: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Minus]", "3"}], 
    SubscriptBox["P", "1"]}], TraditionalForm]],ExpressionUUID->
  "bb5f7d70-d617-4bb3-b806-603a0c2baa2e"],
 " + ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SubscriptBox["P", "2"]}], TraditionalForm]],ExpressionUUID->
  "297f6bf6-46c8-4d67-aed0-2327ca657cec"],
 " = (133, \[Minus]685) and (133, \[Minus]685) is a torsion point of order \
5."
}], "Text",
 CellChangeTimes->{{3.981187360827602*^9, 3.981187575330001*^9}, {
  4.0019949492914*^9, 4.001994949291562*^9}, {4.001996235355764*^9, 
  4.0019962353559017`*^9}},ExpressionUUID->"573589a0-8b3c-41a6-aa34-\
76bb2b4bdece"],

