147af8feb477"],

Cell[TextData[{
 "Let E be given by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "e87a04a1-110b-4139-b77e-ddb565e85df5"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "2078265c-458d-4356-b6a6-e44199ffa853"],
 " + ",
 Cell[BoxData[
  FormBox[
   FractionBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "55c8bb45-d390-48cc-9728-976e428139f4"],
 " + ",
 Cell[BoxData[
  FormBox[
   FractionBox["5", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "072ed7ce-828d-401d-b769-ffbd6ca6624f"],
 " . We may change variables by x ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{"X", "/", 
     SuperscriptBox["6", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "5c2957c9-d34d-4fe8-aa3d-1f7afac392eb"],
 " and y ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{"Y", "/", 
     SuperscriptBox["6", "3"]}]}], TraditionalForm]],ExpressionUUID->
  "52757d7c-5632-40d3-940e-47313a5a8b9f"],
 " to obtain a new equation ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Y", "2"], TraditionalForm]],ExpressionUUID->
  "3d15b783-9a1f-49fa-b01b-c70bd6a151c2"],
 "= ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["X", "3"], TraditionalForm]],ExpressionUUID->
  "7b5b79ee-2e56-4cf6-9faa-e34e7451c26a"],
 " + 648X + 77760 with integral coefficients."
}], "Text",
 CellChangeTimes->{{3.981776851490991*^9, 3.981776871473918*^9}, {
  3.981776901911282*^9, 3.981776932843747*^9}, {4.0023393796150007`*^9, 
