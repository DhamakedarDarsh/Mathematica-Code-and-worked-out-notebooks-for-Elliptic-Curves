Cell[CellGroupData[{

Cell["Exercise 2.11.8.", "Subsubsection",
 CellChangeTimes->{
  4.001745556366632*^9},ExpressionUUID->"92b761ea-b19d-4b68-a9d5-\
0a6ecaf1778b"],

Cell[TextData[{
 "Let p \[GreaterEqual] 2 be a prime and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "p"], TraditionalForm]],ExpressionUUID->
  "0d252fb9-b787-4db5-b425-37a341f4734b"],
 " : ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "7a5b2e4c-3ed2-41bf-9e59-c95af2c8e0a3"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "56399c98-510c-414d-bba2-73925aad6efa"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["p", "2"], TraditionalForm]],ExpressionUUID->
  "2ab3eb2c-585f-4458-a8f1-0a0fc6427046"],
 " . Show that there is no torsion point P \[Element] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "p"], TraditionalForm]],ExpressionUUID->
  "24fa0134-74a8-414f-8828-90836e3479fc"],
 " (Q) with y(P) equal to:\ny = \[PlusMinus]1, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", 
    SuperscriptBox["p", "2"]}], TraditionalForm]],ExpressionUUID->
  "98c47b1f-cd85-44e7-910e-754fd3a7ac1e"],
 " , \[PlusMinus]3p, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[PlusMinus]", "3"}], 
    SuperscriptBox["p", "2"]}], TraditionalForm]],ExpressionUUID->
  "73db3a91-2a24-4f16-a8a2-7db9ba661290"],
 " , or \[PlusMinus] 3.\nProve that Q = (0, p) is a torsion point of exact \
order 3. Conclude that {O, Q, 2Q} are the only torsion points on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "p"], TraditionalForm]],ExpressionUUID->
  "5c7410a3-56c7-49da-98ec-eab442f704bc"],
 "(Q). (Note: for p = 3, the point (\[Minus]2, 1) \[Element] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "3"], TraditionalForm]],ExpressionUUID->
  "d4435f1f-8427-44ec-9122-1934ed36fe4b"],
 "(Q). Show that it is not a torsion point.)"
}], "Text",
 CellChangeTimes->{{4.001745581977168*^9, 4.0017456398373938`*^9}, {
   4.001745697278701*^9, 4.0017456995367107`*^9}, {4.00174574401471*^9, 
   4.0017457457947083`*^9}, 4.001746062492691*^9, 
   4.001746118051491*^9},ExpressionUUID->"f1a033e6-a0d2-42fe-927a-\
471b866a0bd7"],

Cell[TextData[{
 "Let p=7,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["E", "5"], ":", 
     SuperscriptBox["y", "2"]}], "=", 
    RowBox[{
     SuperscriptBox["x", "3"], "+", "49"}]}], TraditionalForm]],
  ExpressionUUID->"658f204e-e642-4dbf-8af6-3516fa551dd1"],
 ","
}], "Text",
 CellChangeTimes->{{4.001745655765003*^9, 4.001745725167419*^9}, {
  4.001745842751749*^9, 
  4.001745844631583*^9}},ExpressionUUID->"e60796f5-cab7-4ec4-aacd-\
09bf470c0317"],

