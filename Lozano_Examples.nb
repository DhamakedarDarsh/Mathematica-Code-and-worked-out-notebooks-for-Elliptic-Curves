 CellChangeTimes->{{3.980217990636936*^9, 
  3.980217994820466*^9}},ExpressionUUID->"883f346d-f29a-479c-b2c7-\
26487ab0fce2"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "b"], TraditionalForm]],ExpressionUUID->
  "fdbf7cb9-6b2a-4a01-9b51-4c6a726f7dc0"],
 ": ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "9fe33df2-1784-4e61-8e42-2b7830db48c0"],
 " + (1 \[Minus] b)x y \[Minus] by = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "8cf78595-2f33-4720-aa98-2276983c4e55"],
 " \[Minus] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["bx", "2"], TraditionalForm]],ExpressionUUID->
  "c31b2ae0-5270-4294-8124-7a27b11da335"],
 " with b \[Element] Q and \[Laplacian](b, c) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b", "5"], TraditionalForm]],ExpressionUUID->
  "c944dac8-f7b0-410f-b415-fd293be75aaf"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SuperscriptBox["b", "2"]}], TraditionalForm]],ExpressionUUID->
  "9009ea18-3861-409e-8a76-95d713354ace"],
 " \[Minus] 11b \[Minus] 1)\[NotEqual]0. Then, the torsion subgroup of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "b"], TraditionalForm]],ExpressionUUID->
  "f53c3f0d-bcb4-4170-9e52-ad7e35993282"],
 " (Q) contains a subgroup isomorphic to Z/5Z, and (0, 0) is a point of exact \
order 5.\nLet b = -1 :"
}], "Text",
 CellChangeTimes->{{3.9802180340127077`*^9, 3.9802181528792887`*^9}, {
  3.980218213796217*^9, 3.980218310584853*^9}, {3.980218351336568*^9, 
