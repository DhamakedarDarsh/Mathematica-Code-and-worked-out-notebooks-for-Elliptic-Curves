Cell[TextData[{
 "(2) The curve ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ba26d8e4-9288-4f67-873b-f09a7cb9b71e"],
 "/Q : ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f6e9ebec-7c7d-4424-9a69-4cc1b811c308"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "567f25cf-9ee3-42aa-9287-18a27b602c92"],
 " + 1 has only 6 rational points. The point P = (2, 3) has exact order 6. \
Therefore ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e40080e0-cc2a-46f4-96a0-6425ca877573"],
 "(Q)\[TildeFullEqual]Z/6Z is an isomorphism of groups. Since there are no \
points of infinite order, the rank of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a86bd6c4-4e75-4003-ae6f-119e8ce00009"],
 "/Q is 0, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8e77d2dc-47df-4756-bb45-804eaf29136d"],
 "(Q) = {O, P, 2P, 3P, 4P, 5P } = {O, (2, \[PlusMinus]3), (0, \[PlusMinus]1), \
(\[Minus]1, 0)}."
}], "Text",
 CellChangeTimes->{{4.002341981422245*^9, 
  4.0023420971530247`*^9}},ExpressionUUID->"47ac0a12-8825-45bd-9553-\
fc079a67da81"],

