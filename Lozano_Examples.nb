Cell[CellGroupData[{

Cell["Example 2.5.15.", "Subsection",
 CellChangeTimes->{
  3.981185001854751*^9},ExpressionUUID->"c2a3862c-716b-4259-9c50-\
cbc0863f71bc"],

Cell[TextData[{
 "Let E/Q : ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "1931554e-0e6d-4752-b32f-6770269d1cb7"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "344d565e-07ad-4015-a288-12733779e518"],
 " + 4249388. E has good reduction at 5 and 7. The curve E/Q has a rational \
point P = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     FractionBox["25502", "169"], ",", 
     FractionBox["6090670", "2197"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4ad2d66e-680d-4f18-8da7-6248c18df92e"],
 "). Since the torsion of E(Q) is trivial, P must be of infinite order."
}], "Text",
 CellChangeTimes->{{3.9811850325128*^9, 3.981185040821686*^9}, {
  4.002522392139432*^9, 4.002522395523343*^9}, {4.002522430678855*^9, 
  4.002522432020756*^9}, {4.002522513213608*^9, 4.002522513845069*^9}, {
  4.002522589167975*^9, 
