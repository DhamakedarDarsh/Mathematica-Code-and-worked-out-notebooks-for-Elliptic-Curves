Cell[TextData[{
 "Therefore, the point (\[Minus]2, 1) \[Element] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "3"], TraditionalForm]],ExpressionUUID->
  "c4a3cadc-01db-4e80-a450-6aebd339d920"],
 "(Q) is not a torsion point."
}], "Text",
