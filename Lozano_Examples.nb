Cell[TextData[{
 "The curve E : ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6bbe0a68-6e90-4d8d-8217-ef769d81e715"],
