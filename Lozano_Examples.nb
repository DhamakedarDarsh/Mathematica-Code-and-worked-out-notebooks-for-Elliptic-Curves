Cell[TextData[{
 "The curve ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["y", 
     RowBox[{"2", " "}]], "=", " ", 
    RowBox[{
     SuperscriptBox["x", "3"], "-", 
     RowBox[{
      SuperscriptBox["n", "2"], "x", " "}]}]}], TraditionalForm]],
  ExpressionUUID->"9919b6ea-b241-42a8-9e1c-f09d28753f66"],
 "has three obvious rational points, namely P = (0, 0), Q = (-n, 0), T = (n, \
0), and we will show that each of these three points is torsion of order 2.\n\
Let n = 1,"
}], "Text",
 CellChangeTimes->{{3.9798913293910933`*^9, 
  3.979891580950279*^9}},ExpressionUUID->"58f885eb-2137-499c-93b6-\
