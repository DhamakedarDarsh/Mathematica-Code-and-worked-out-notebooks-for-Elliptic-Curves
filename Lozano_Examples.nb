bbda1bb2c451"],

Cell[TextData[{
 "The discriminant of the elliptic curve ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "167b6da7-fc9e-4456-9306-e130fb05712c"],
 " : ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a4c53236-f46b-4ea3-b2a9-b0e49e03307f"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5c4431e1-e119-4664-a27c-71b7f25b0041"],
 " + 35x + 5 is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Laplacian]", 
    SubscriptBox["E", "1"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "105959ff-93bc-43ae-a76f-2a8181cd1333"],
 "= \[Minus]2754800 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Minus]", 
    SuperscriptBox["2", "4"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a3cd28a5-ef89-4bb1-9d3e-f2a0e6368a1a"],
 " \[CenterDot] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["5", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4193a005-d1b3-4e9c-8407-b507107c5bf4"],
 " \[CenterDot] ",
 Cell[BoxData[
  FormBox["71", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e30664ee-a9ed-463d-b167-02196e266d70"],
 " \[CenterDot] ",
 Cell[BoxData[
  FormBox["97", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "71c8e902-cf81-4b43-a94f-a648b779682c"],
 "."
}], "Text",
 CellChangeTimes->{{3.981184624737234*^9, 
