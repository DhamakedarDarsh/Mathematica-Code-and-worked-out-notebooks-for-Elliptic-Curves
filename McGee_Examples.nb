Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "These", " ", "examples", " ", "were", " ", "executed", " ", "using", " ", 
    "Mathematica", " ", 
    RowBox[{"13.2", ".", " ", "In"}], " ", "case", " ", "you", " ", "run", 
