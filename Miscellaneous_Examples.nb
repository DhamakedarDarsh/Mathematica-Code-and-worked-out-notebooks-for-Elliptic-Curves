Cell[CellGroupData[{

Cell["\<\
PART 4 -- Package settings, prime counts and fast point counting \
\>", "Section",
 CellChangeTimes->{
  4.0034813397349205`*^9},ExpressionUUID->"0a9ca426-e3b3-4f9a-a16a-\
df31c5c51c70"],

Cell["\<\
Curves: E1 : y^2 = x^3 - x (short {-1,0}) and E2 : y^2 + y = x^3 - x (long \
{0,0,1,-1,0}, Delta = 37).\
\>", "Text",ExpressionUUID->"44dd7406-7598-4264-bcf7-01de1d454525"],

