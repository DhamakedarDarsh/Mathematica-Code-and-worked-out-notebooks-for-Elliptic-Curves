Cell[CellGroupData[{

Cell["2.6  Characteristic 2 and 3 reductions of E2", "Subsubsection",ExpressionUUID->"ab46ed5f-d7c2-4c50-a179-52061bf42994"],

Cell[CellGroupData[{

Cell["\<\
(* Delta = 37 is coprime to 2 and 3, so both reductions are nonsingular *)
nf2 = ECPNormalFormCharTwoThree[{0, 0, 1, -1, 0}, 2];
Print[\"ECPNormalFormCharTwoThree[E2,2]               = \", nf2];   (* \
supersingular (a1=0): y^2+y=x^3+x over F_2 *)
nf3 = ECPNormalFormCharTwoThree[{0, 0, 1, -1, 0}, 3];
Print[\"ECPNormalFormCharTwoThree[E2,3]               = \", nf3];   (* \
supersingular (b2=0): y^2=x^3+2x+1 over F_3 *)
sw2 = ECPToShortWeierstrassFp[{0, 0, 1, -1, 0}, 2];
Print[\"ECPToShortWeierstrassFp[E2,2]                 = \", sw2];   (* \
PureShortQ False at p=2 *)
sw3 = ECPToShortWeierstrassFp[{0, 0, 1, -1, 0}, 3];
Print[\"ECPToShortWeierstrassFp[E2,3]                 = \", sw3];   (* \
PureShortQ True, ShortPair {2,1} *)
pt2 = ECPToShortCoordinatesFp[{0, 0}, {0, 0, 1, -1, 0}, 2];
Print[\"ECPToShortCoordinatesFp[{0,0},E2,2]           = \", pt2];
Print[\"ECPFromShortCoordinatesFp[pt2,E2,2]           = \", \
ECPFromShortCoordinatesFp[pt2, {0, 0, 1, -1, 0}, 2]];   (* recovers {0,0} *)
pt3 = ECPToShortCoordinatesFp[{0, 0}, {0, 0, 1, -1, 0}, 3];
Print[\"ECPToShortCoordinatesFp[{0,0},E2,3]           = \", pt3];
Print[\"ECPFromShortCoordinatesFp[pt3,E2,3]           = \", \
ECPFromShortCoordinatesFp[pt3, {0, 0, 1, -1, 0}, 3]];   (* recovers {0,0} *)
(* (0,0) and (0,-1) collapse mod 2 and mod 3 respectively: adding a point to \
its negative is Infinity *)
Print[\"ECPAddFp[{0,0},{0,1},{0,0,1,-1,0},2]          = \", ECPAddFp[{0, 0}, \
{0, 1}, {0, 0, 1, -1, 0}, 2]];   (* Infinity *)
Print[\"ECPAddFp[{0,0},{0,2},{0,0,1,-1,0},3]          = \", ECPAddFp[{0, 0}, \
{0, 2}, {0, 0, 1, -1, 0}, 3]];   (* Infinity *)
Print[\"ECPSEAPointCount[{0,0,1,-1,0},2]              = \", \
ECPSEAPointCount[{0, 0, 1, -1, 0}, 2]];   (* 5 *)
Print[\"ECPSEAPointCount[{0,0,1,-1,0},3]              = \", \
ECPSEAPointCount[{0, 0, 1, -1, 0}, 3]];   (* 7 *)
Print[\"ECPPointQFp[{1,1},{0,0,1,-1,0},2]             = \", ECPPointQFp[{1, \
1}, {0, 0, 1, -1, 0}, 2]];   (* True *)
Print[\"ECPPointQFp[{1,0},{0,0,1,-1,0},3]             = \", ECPPointQFp[{1, \
0}, {0, 0, 1, -1, 0}, 3]];   (* True *)\
\>", "Input",
