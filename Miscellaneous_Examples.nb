Cell[CellGroupData[{

Cell["3.4  Torsion basis ECPTorsionBasisFp[n, curve, field]", "Subsubsection",ExpressionUUID->"4286745a-07f7-4180-a0d3-23d64bf199b5"],

Cell[CellGroupData[{

Cell["\<\
basis2 = ECPTorsionBasisFp[2, {-1, 0}, 5];
Print[\"ECPTorsionBasisFp[2,{-1,0},5]                 = \", basis2];   (* two \
independent points of order 2 *)
Print[\"  e_2 of the basis                            = \", \
ECPWeilPairingFp[2, basis2[[1]], basis2[[2]], {-1, 0}, 5]];   (* 4 (= -1), \
primitive 2nd root *)
basis4 = ECPTorsionBasisFp[4, {-1, 0}, 17];
Print[\"ECPTorsionBasisFp[4,{-1,0},17]                = \", basis4];   (* P \
of exact order 4, with Q generating E[4] *)
w = ECPWeilPairingFp[4, basis4[[1]], basis4[[2]], {-1, 0}, 17];
Print[\"  primitive 4th root? {w^4==1, w^2!=1}        = \", {PowerMod[w, 4, \
17] == 1, PowerMod[w, 2, 17] != 1}];   (* {True, True} *)
(* E[4] is not contained in E(F_5): a message asks for an extension field *)
Print[\"ECPTorsionBasisFp[4,{-1,0},5]                 = \", \
ECPTorsionBasisFp[4, {-1, 0}, 5]];   (* $Failed + message *)\
\>", "Input",
 CellLabel->
  "In[578]:=",ExpressionUUID->"2a7df29f-4c9a-4ea4-9cf1-8ae3de79e0b3"],

