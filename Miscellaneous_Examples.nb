ECPSEAPointCount[{-1, 0}, {5, 2}]];   (* expect 32 (Lucas sequence from \
#E(F_5) = 8) *)
Print[\"ECPGroupFp[{-1,0},{5,2}]                      = \", ECPGroupFp[{-1, \
0}, {5, 2}]];   (* Order 32; elements 0 / g^k *)
basisX = ECPTorsionBasisFp[2, {-1, 0}, {5, 2}];
Print[\"ECPTorsionBasisFp[2,{-1,0},{5,2}]             = \", basisX];
Print[\"  e_2 of the basis over F_25                  = \", \
ECPWeilPairingFp[2, basisX[[1]], basisX[[2]], {-1, 0}, {5, 2}]];   (* -1, \
printed as g^12 since g^24 = 1 *)\
