Cell[CellGroupData[{

Cell["PART 3 -- Miller's function and pairings over F_q ", "Section",
 CellChangeTimes->{
  4.0034813439471292`*^9},ExpressionUUID->"3e3c09c7-eea4-4f93-ab75-\
97b8b4ce67a1"],

Cell["\<\
Curve for this part: E1 : y^2 = x^3 - x, i.e. {A,B} = {-1,0}. Over F_5 it has \
8 points (group Z/2 x Z/4, so E[2] is rational). Over F_17 it has 16 points \
and E(F_17) = Z/4 x Z/4, so the full 4-torsion is rational and 4 divides 17 - \
1. Pairing values written in the 'expect' comments were computed \
independently with an independent Python implementation of the same Miller \
loop and sign convention.\
\>", "Text",ExpressionUUID->"a3c5270d-4873-42aa-b1ad-c5e51b636f9e"],

Cell[CellGroupData[{

Cell["3.1  The group E(F_q): ECPGroupFp", "Subsubsection",ExpressionUUID->"91f34b73-228e-488d-a8d5-6ec997be957e"],

Cell[CellGroupData[{

Cell["\<\
Print[\"ECPGroupFp[{-1,0},5]                          = \", ECPGroupFp[{-1, \
0}, 5]];   (* Order 8, Invariants {2,4} *)
Print[\"ECPGroupFp[{-1,0},17]                         = \", ECPGroupFp[{-1, \
0}, 17]];   (* Order 16, Invariants {4,4}, Structure Z/4 x Z/4 *)
Print[\"ECPSEAPointCount[{-1,0},17]                   = \", \
ECPSEAPointCount[{-1, 0}, 17]];   (* 16 -- agrees with the enumeration *)\
\>", "Input",
 CellLabel->
  "In[552]:=",ExpressionUUID->"d14a7c49-d1ed-4d07-85c5-8a5d8e51ef2b"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"ECPGroupFp[{-1,0},5]                          = \"\>", 
   "\[InvisibleSpace]", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Field\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"5", ",", "1"}], "}"}]}], ",", 
     RowBox[{"\<\"Curve\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", "4", ",", "0"}], "}"}]}], ",", 
     RowBox[{"\<\"Order\"\>", "\[Rule]", "8"}], ",", 
     RowBox[{"\<\"Invariants\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"2", ",", "4"}], "}"}]}], ",", 
     RowBox[{"\<\"Structure\"\>", "\[Rule]", "\<\"Z/2 x Z/4\"\>"}], ",", 
     RowBox[{"\<\"Generators\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"\<\"Points\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\[Infinity]", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"3", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}]}], 
    "\[RightAssociation]"}]}],
  SequenceForm[
  "ECPGroupFp[{-1,0},5]                          = ", <|
   "Field" -> {5, 1}, "Curve" -> {0, 0, 0, 4, 0}, "Order" -> 8, 
    "Invariants" -> {2, 4}, "Structure" -> "Z/2 x Z/4", 
    "Generators" -> {{3, 3}, {1, 0}}, "Points" -> {
      DirectedInfinity[1], {0, 0}, {1, 0}, {3, 3}, {3, 2}, {4, 0}, {2, 1}, {2,
       4}}|>],
  Editable->False]], "Print",
 CellChangeTimes->{4.0034809782072897`*^9},
