    RowBox[{"1296", " ", "x"}], "-", 
    SuperscriptBox["x", "3"], "+", 
    SuperscriptBox["y", "2"]}]}],
  SequenceForm[
  "ECPShortWierstrass[Automatic]                 = ", -11664 + 
