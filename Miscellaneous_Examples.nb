Cell["1.2  Minimality", "Subsubsection",ExpressionUUID->"bf65946c-39ee-4ed2-8d55-9572006555db"],

Cell[CellGroupData[{

Cell["\<\
Print[\"ECPIsMinimalShort[{-1,0}]                     = \", \
ECPIsMinimalShort[{-1, 0}]];   (* True *)
Print[\"ECPMinimalQ[{-1,0}]                           = \", ECPMinimalQ[{-1, \
0}]];   (* True *)
Print[\"ECPMinimalQ[{-1,0},2]                         = \", ECPMinimalQ[{-1, \
0}, 2]];   (* True *)
Print[\"ECPIsMinimal[{0,0,0,-1,0}]                    = \", ECPIsMinimal[{0, \
0, 0, -1, 0}]];   (* True *)
Print[\"ECPMinimalModelShort[{-1,0}]                  = \", \
ECPMinimalModelShort[{-1, 0}]];   (* fixed point *)\
\>", "Input",
