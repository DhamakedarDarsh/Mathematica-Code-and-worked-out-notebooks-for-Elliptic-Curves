(* expect \"1.0\" *)
Print[\"$ECPFqTableLimit                              = \", \
$ECPFqTableLimit];   (* default 10^31 (the usage message says 10^60): largest \
q = p^r with discrete-log tables *)
Print[\"$ECPNagellLutzDiscLimit                       = \", \
$ECPNagellLutzDiscLimit];   (* default 10^60: largest |Delta| for exact \
Nagell-Lutz *)\
