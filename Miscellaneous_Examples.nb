     RowBox[{"\<\"OldDiscriminant\"\>", "\[Rule]", "37"}], ",", 
     RowBox[{"\<\"IsMinimal\"\>", "\[Rule]", "True"}]}], 
    "\[RightAssociation]"}]}],
