Cell[CellGroupData[{

Cell["2.7  Tate's algorithm and the conductor", "Subsubsection",ExpressionUUID->"0a86365e-c951-4a61-99f9-793b55b0a3de"],

Cell[CellGroupData[{

Cell["\<\
Print[\"ECPTate[{0,0,1,-1,0},37]                      = \", ECPTate[{0, 0, 1, \
-1, 0}, 37]];   (* f = 1, Kodaira type I1 (Delta = 37) *)
Print[\"ECPLocalData[{0,0,1,-1,0}]                    = \", ECPLocalData[{0, \
0, 1, -1, 0}]];   (* single prime 37 *)
Print[\"ECPConductor[{0,0,1,-1,0}]                    = \", ECPConductor[{0, \
0, 1, -1, 0}]];   (* expect 37 *)
Print[\"ECPAnalyticRank[{0,0,1,-1,0}]                 = \", \
ECPAnalyticRank[{0, 0, 1, -1, 0}]];   (* Rank 1, Parity -1, Conductor 37 *)\
\>", "Input",
 CellLabel->
  "In[548]:=",ExpressionUUID->"70faa0ee-7e68-4ea9-a9ac-9bfccca602f3"],

