Cell[CellGroupData[{

Cell["2.5  Heights, independence, rank, generators", "Subsubsection",ExpressionUUID->"00878b3e-3654-4c8d-aec1-19ede4a1e811"],

Cell[CellGroupData[{

Cell["\<\
hP = ECPCanonicalHeight[P, Automatic];
Print[\"ECPCanonicalHeight[P,Automatic]               = \", hP];   (* \
regulator of 37.a1, approx 0.0511114 *)
Print[\"ECPHeightPairing[P,P,Automatic]               = \", \
ECPHeightPairing[P, P, Automatic]];   (* equals hP *)
Print[\"ECPHeightMatrix[{P},Automatic]                = \", \
ECPHeightMatrix[{P}, Automatic]];   (* 1x1 matrix {{hP}} *)
Print[\"ECPIndependentQ[{P},Automatic]                = \", \
ECPIndependentQ[{P}, Automatic]];   (* True: nonzero height *)
Print[\"ECPRankUpperBound[Automatic]                  = \", \
ECPRankUpperBound[Automatic]];   (* heuristic: Delta = 37 prime -> 1 (happens \
to be correct) *)
(* This one can be slow (about a minute): a bounded point search on the \
integral short model *)
Print[\"ECPFindGenerators[Automatic]                  = \", \
ECPFindGenerators[Automatic]];   (* Rank 1, one generator, mapped back to E2 \
coordinates *)\
\>", "Input",
 CellLabel->
  "In[518]:=",ExpressionUUID->"66086055-5ad4-4dc9-b1a0-75af313ce681"],

