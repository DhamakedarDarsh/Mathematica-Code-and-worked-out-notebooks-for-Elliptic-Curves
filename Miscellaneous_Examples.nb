Cell["\<\
1.6  Rank heuristic, generator search, analytic rank, local data\
\>", "Subsubsection",ExpressionUUID->"e6ac4224-0847-498c-a71b-973ee3cecac9"],

Cell[CellGroupData[{

Cell["\<\
Print[\"ECPRankUpperBound[{-1,0}]                     = \", \
ECPRankUpperBound[{-1, 0}]];   (* HEURISTIC: Delta = 2^6 has one prime factor \
-> guesses 1, true rank is 0 *)
Print[\"ECPFindGenerators[{-1,0}]                     = \", \
ECPFindGenerators[{-1, 0}]];   (* expect Rank 0, Generators {} *)
Print[\"ECPAnalyticRank[{0,0,0,-1,0}]                 = \", \
ECPAnalyticRank[{0, 0, 0, -1, 0}]];   (* Rank 0, Parity 1, Conductor 32 (rank \
true assuming BSD) *)
Print[\"ECPConductor[{0,0,0,-1,0}]                    = \", ECPConductor[{0, \
0, 0, -1, 0}]];   (* expect 32 *)
Print[\"ECPLocalData[{0,0,0,-1,0}]                    = \", ECPLocalData[{0, \
0, 0, -1, 0}]];   (* Tate data at p = 2 *)\
\>", "Input",
