Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"G = ECPFindPointFp[7,E2,999983]               = \"\>", 
   "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"700", ",", "605077"}], "}"}]}],
  SequenceForm[
  "G = ECPFindPointFp[7,E2,999983]               = ", {700, 605077}],
  Editable->False]], "Print",
