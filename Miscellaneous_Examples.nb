Cell[CellGroupData[{

Cell["\<\
1.7  Alternative models, flex geometry and raw polynomial tools\
\>", "Subsubsection",ExpressionUUID->"fb692341-c6f4-42df-9aa9-268f471123c3"],

Cell[CellGroupData[{

Cell["\<\
(* E1 is the Legendre curve y^2 = x(x-1)(x-lambda) at lambda = -1 *)
legendreAB = ECPLegendreToWeierstrass[-1];
Print[\"ECPLegendreToWeierstrass[-1]                  = \", legendreAB];   (* \
expect {-1296,0} *)
Print[\"  same j-invariant as E1                      = \", \
ECPJInvariant[legendreAB] == ECPJInvariant[{-1, 0}]];   (* True (both 1728) *)
quarticAB = ECPQuarticToWeierstrass[{1, 0, 0, 0, 1}];   (* y^2 = x^4 + 1 *)
Print[\"ECPQuarticToWeierstrass[{1,0,0,0,1}]          = \", quarticAB];   (* \
expect {-324,0} *)
Print[\"  JInvariant of the Jacobian                  = \", \
ECPJInvariant[quarticAB]];   (* 1728 again *)
Print[\"ECPToWeierstrassForm[y^2-(x^3-x),{x,y}]       = \", \
ECPToWeierstrassForm[y^2 - (x^3 - x), {x, y}]];   (* reproduces E1 *)
Print[\"ECPParseHomogeneousCurve[{-1,0}]              = \", \
ECPParseHomogeneousCurve[{-1, 0}]];   (* cubic in x,y,z *)
Print[\"ECPPolynomialHomogeneous[x^3-x z^2-y^2 z,{x,y,z}]= \", \
ECPPolynomialHomogeneous[x^3 - x*z^2 - y^2*z, {x, y, z}]];   (* True *)
Print[\"ECPPolynomialHomogeneous[x^3-x,{x,y}]         = \", \
ECPPolynomialHomogeneous[x^3 - x, {x, y}]];   (* False *)
Print[\"ECPPolynomialTransform[x^2+y^2,{x,y},{{1,1},{0,1}}]= \", \
ECPPolynomialTransform[x^2 + y^2, {x, y}, {{1, 1}, {0, 1}}]];   (* (x+y)^2 + \
y^2 expanded *)
(* At a 2-torsion point the tangent is vertical: the third intersection is \
already Infinity, i.e. [0:1:0] *)
Print[\"ECPChordAndTangent[{0,0,1},{-1,0}]            = \", \
ECPChordAndTangent[{0, 0, 1}, {-1, 0}]];   (* expect {0,1,0} *)
Print[\"ECPAreProjectivelyEquivalent[{0,0,1},{0,0,2}] = \", \
ECPAreProjectivelyEquivalent[{0, 0, 1}, {0, 0, 2}]];   (* True *)
Print[\"ECPAreProjectivelyEquivalent[{0,0,1},{1,0,1}] = \", \
ECPAreProjectivelyEquivalent[{0, 0, 1}, {1, 0, 1}]];   (* False *)
(* Cubic -> Weierstrass from a rational point on a general cubic *)
Print[\"ECPCubicToWeierstrass[{0,0,1},x^3-x z^2-y^2 z]= \", \
ECPCubicToWeierstrass[{0, 0, 1}, x^3 - x*z^2 - y^2*z]];   (* a Weierstrass \
equation isomorphic to E1 *)\
\>", "Input",
 CellLabel->
  "In[454]:=",ExpressionUUID->"4a1b8ef4-b20f-4bb5-99a5-d052455e781c"],

