  RowBox[{"\<\"ECPJFunction[{-1,t}]                          = \"\>", 
   "\[InvisibleSpace]", 
   RowBox[{"-", 
    FractionBox["6912", 
     RowBox[{
      RowBox[{"-", "4"}], "+", 
      RowBox[{"27", " ", 
       SuperscriptBox["t", "2"]}]}]]}]}],
  SequenceForm[
  "ECPJFunction[{-1,t}]                          = ", (-6912)/(-4 + 
