Cell[CellGroupData[{

Cell["2.2  Short <-> long coordinate conversions", "Subsubsection",ExpressionUUID->"3fb6b2c3-5645-4321-81fe-6b57e1a98f91"],

Cell[CellGroupData[{

Cell["\<\
shortE2 = ECPToShortWeierstrass[Automatic];
Print[\"ECPToShortWeierstrass[Automatic]              = \", shortE2];   (* \
Y^2 = X^3 - X + 1/4 *)
Print[\"ECPShortWierstrass[Automatic]                 = \", \
ECPShortWierstrass[Automatic]];   (* scaled polynomial form (note original \
spelling) *)
toShortPt = ECPToShortCoordinates[{0, 0}, Automatic];
Print[\"ECPToShortCoordinates[{0,0},Automatic]        = \", toShortPt];   (* \
expect {0,1/2} *)
Print[\"ECPFromShortCoordinates[toShortPt,Automatic]  = \", \
ECPFromShortCoordinates[toShortPt, Automatic]];   (* recovers {0,0} *)
Print[\"ECPOnCurveQ[{0,0},Automatic]                  = \", ECPOnCurveQ[{0, \
0}, Automatic]];   (* True *)
Print[\"ECPPointQ[y^2+y-(x^3-x),0,0]                  = \", ECPPointQ[{0, 0}, \
y^2 + y - (x^3 - x)]];   (* True *)\
\>", "Input",
 CellLabel->
  "In[480]:=",ExpressionUUID->"a9c462e3-6409-4ef4-8286-6a2a7074abc8"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"ECPToShortWeierstrass[Automatic]              = \"\>", 
   "\[InvisibleSpace]", 
   RowBox[{
    SuperscriptBox["Y", "2"], "\[Equal]", 
    RowBox[{
     FractionBox["1", "4"], "-", "X", "+", 
     SuperscriptBox["X", "3"]}]}]}],
  SequenceForm[
  "ECPToShortWeierstrass[Automatic]              = ", $CellContext`Y^2 == 
   Rational[1, 4] - $CellContext`X + $CellContext`X^3],
  Editable->False]], "Print",
 CellChangeTimes->{4.0034809312709737`*^9},
 CellLabel->
  "During evaluation of \
In[480]:=",ExpressionUUID->"b49a7794-d5ca-4ec3-bc8d-fd62d70d1f3d"],

