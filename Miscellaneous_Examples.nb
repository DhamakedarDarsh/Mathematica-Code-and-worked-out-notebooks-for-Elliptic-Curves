Cell["\<\

(*   E1 : y^2 = x^3 - x          over Q   (short {A,B}={-1,0})    *)
(*   E2 : y^2 + y = x^3 - x      over Q   (long form, LMFDB 37.a1)*)
(*   E3 : E1 reduced mod 5, 17   (pairings, Part 3)               *)

(* ============================================================ *)\
\>", "Input",
 CellChangeTimes->{{4.0034810780851817`*^9, 4.0034811234089355`*^9}, {
  4.0034812660792637`*^9, 
  4.0034812867860656`*^9}},ExpressionUUID->"c2ca584c-c1fb-4d1f-8034-\
9cd9d8a8215b"],

Cell[CellGroupData[{

Cell["\<\
PART 1 -- E1 : y^2 = x^3 - x over Q (short form {A,B} = {-1,0})\
\>", "Section",ExpressionUUID->"1789792f-8583-4b9e-8174-33971143a8a9"],

Cell[CellGroupData[{

Cell["1.1  Session curve, parsing, invariants", "Subsubsection",ExpressionUUID->"b4b28509-3ac9-4f77-bc8f-91065324eeec"],

Cell[CellGroupData[{

Cell["\<\
ECPSetEC[{0, 0, 0, -1, 0}];
Print[\"$ECPCurrentEC                                 = \", $ECPCurrentEC];
Print[\"ECPParseAffineCurve[{0,0,0,-1,0}]             = \", \
ECPParseAffineCurve[{0, 0, 0, -1, 0}]];
Print[\"ECPExtractCoefficients[{-1,0}]                = \", \
ECPExtractCoefficients[{-1, 0}]];   (* expect {0,0,0,-1,0} *)
Print[\"ECPFormattedEquation[Automatic]               = \", \
ECPFormattedEquation[Automatic]];
Print[\"ECPWInvariants[Automatic]                     = \", \
ECPWInvariants[Automatic]];   (* c4=48, c6=0, Discriminant=64 *)
Print[\"ECPWeierstrassDiscriminant[Automatic]         = \", \
ECPWeierstrassDiscriminant[Automatic]];   (* expect 64 *)
Print[\"ECPShortDiscriminant[{-1,0}]                  = \", \
ECPShortDiscriminant[{-1, 0}]];   (* expect 64 *)
Print[\"ECPJInvariant[{-1,0}]                         = \", \
ECPJInvariant[{-1, 0}]];   (* expect 1728 (CM by i) *)\
\>", "Input",
 CellLabel->
  "In[412]:=",ExpressionUUID->"2d3806d8-fefb-49da-83e2-3dd64a1dee3b"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Session curve set to: \"\>", "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{"x", "-", 
     SuperscriptBox["x", "3"], "+", 
     SuperscriptBox["y", "2"]}], "\[Equal]", "0"}]}],
  SequenceForm[
  "Session curve set to: ", $CellContext`x - $CellContext`x^3 + \
