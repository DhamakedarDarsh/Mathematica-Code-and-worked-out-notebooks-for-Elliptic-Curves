Cell[CellGroupData[{

Cell["\<\
PART 6 -- Families over Q(t): j-function, Kodaira fibres and F-theory data \
\>", "Section",
 CellChangeTimes->{
  4.00348133515325*^9},ExpressionUUID->"944a7c46-10ab-43ad-b81c-55c4a5ca8916"],

Cell[CellGroupData[{

Cell["6.1  j as a function of a parameter", "Subsubsection",ExpressionUUID->"3b580c01-bb7c-4692-ad85-46fe707ea390"],

Cell[CellGroupData[{

Cell["\<\
Print[\"ECPJFunction[{-1,t}]                          = \", ECPJFunction[{-1, \
t}]];   (* expect 6912/(4 - 27 t^2) *)
Print[\"ECPJFunction[X1(5) family]                    = \", \
ECPJFunction[ECPTorsionFamily[5, d][\"Coefficients\"]]];   (* expect \
(d^4-12d^3+14d^2+12d+1)^3/(d^5 (d^2-11d-1)) *)\
\>", "Input",
 CellLabel->
  "In[640]:=",ExpressionUUID->"0e99ff5f-0fc0-4c8d-92f5-5aff33443e46"],

