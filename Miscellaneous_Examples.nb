Cell["\<\
Print[\"ECPShortWeierstrassForm[{0,0,1,-1,0}]         = \", \
ECPShortWeierstrassForm[{0, 0, 1, -1, 0}]];   (* short model of E2 (A = -1, B \
= 1/4 up to scaling) *)
Print[\"  same as legacy ECPShortWierstrass           = \", \
ECPShortWeierstrassForm[{0, 0, 1, -1, 0}] === ECPShortWierstrass[{0, 0, 1, \
-1, 0}]];   (* True *)\
