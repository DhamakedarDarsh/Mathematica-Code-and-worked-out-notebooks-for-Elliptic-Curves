Cell[CellGroupData[{

Cell["2.4  Group law on the real generator", "Subsubsection",ExpressionUUID->"17bf252b-8caa-4af5-881d-255b2d9200e8"],

Cell[CellGroupData[{

Cell["\<\
P = {0, 0};
twoP = ECPAdd[P, P, Automatic];
threeP = ECPAdd[P, twoP, Automatic];
Print[\"2P = ECPAdd[P,P,Automatic]                    = \", twoP];   (* \
exactly {1,0} *)
Print[\"3P = ECPAdd[P,2P,Automatic]                   = \", threeP];   (* \
exactly {-1,-1} *)
Print[\"ECPMultiply[3,P,Automatic]                    = \", ECPMultiply[3, P, \
Automatic]];   (* must agree with 3P *)
Print[\"ECPPointOrder[P,Automatic]                    = \", ECPPointOrder[P, \
Automatic]];   (* Infinity: rank-1 generator *)
Print[\"ECPFindTorsionPoints[Automatic]               = \", \
ECPFindTorsionPoints[Automatic]];   (* {Infinity} *)
Print[\"ECPTorsionSubgroup[Automatic]                 = \", \
ECPTorsionSubgroup[Automatic]];   (* Order 1 *)
Print[\"ECPSearchPoints[Automatic,10]                 = \", \
ECPSearchPoints[Automatic, 10]];   (* +-P, +-2P, +-3P, ... within the bound *)\
\>", "Input",
 CellLabel->
  "In[508]:=",ExpressionUUID->"1e9a6759-e35c-4371-9f7b-3727cd65855a"],

