Cell[CellGroupData[{

Cell["6.4  All singular fibres of a rational elliptic surface", \
"Subsubsection",ExpressionUUID->"81ec8da3-04bc-421f-91b6-21fa80b4e973"],

Cell["\<\
The universal curve with a point of order 6 over Q(d) is a rational elliptic \
surface (n = 1), so the Euler numbers of its singular fibres add up to 12; \
the book-keeping is I6 + I3 + I2 + I1.\
\>", "Text",ExpressionUUID->"69e51351-a023-4c1f-8f2d-e76b5ce01683"],

Cell[CellGroupData[{

Cell["\<\
fam6 = ECPTorsionFamily[6, d];
Print[\"ECPTorsionFamily[6,d]                         = \", fam6];   (* \
Coefficients {1-c,-b,-b,0,0} with b = d + d^2, c = d *)
fl6 = ECPFibreList[fam6[\"Coefficients\"], d];
Print[\"fibre types                                   = \", \
Lookup[fl6[\"Fibres\"], \"Type\"]];   (* I6, I3, I2, I1 (one may sit at \
Infinity) *)
Print[\"TotalEuler / ExpectedEuler                    = \", {fl6[\"TotalEuler\
\"], fl6[\"ExpectedEuler\"], fl6[\"ConsistentQ\"]}];   (* {12, 12, True} *)
Print[\"ECPFibreAtInfinity[fam6,d]                    = \", \
ECPFibreAtInfinity[fam6[\"Coefficients\"], d]];   (* the fibre at d = \
Infinity *)\
\>", "Input",
 CellLabel->
  "In[659]:=",ExpressionUUID->"c513e43d-c85f-433f-ba82-4abcd9381605"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"ECPTorsionFamily[6,d]                         = \"\>", 
   "\[InvisibleSpace]", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Coefficients\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "-", "d"}], ",", 
        RowBox[{
         RowBox[{"-", "d"}], "-", 
         SuperscriptBox["d", "2"]}], ",", 
        RowBox[{
         RowBox[{"-", "d"}], "-", 
         SuperscriptBox["d", "2"]}], ",", "0", ",", "0"}], "}"}]}], ",", 
     RowBox[{"\<\"b\"\>", "\[Rule]", 
      RowBox[{"d", "+", 
       SuperscriptBox["d", "2"]}]}], ",", 
     RowBox[{"\<\"c\"\>", "\[Rule]", "d"}], ",", 
     RowBox[{"\<\"Parameter\"\>", "\[Rule]", "d"}]}], 
    "\[RightAssociation]"}]}],
  SequenceForm[
  "ECPTorsionFamily[6,d]                         = ", <|
   "Coefficients" -> {
     1 - $CellContext`d, -$CellContext`d - $CellContext`d^2, -$CellContext`d - \
$CellContext`d^2, 0, 0}, "b" -> $CellContext`d + $CellContext`d^2, 
    "c" -> $CellContext`d, "Parameter" -> $CellContext`d|>],
  Editable->False]], "Print",
 CellChangeTimes->{4.0034809910678024`*^9},
 CellLabel->
  "During evaluation of \
In[659]:=",ExpressionUUID->"adae306e-69f1-413b-86e1-f79bb1a3b8f0"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"fibre types                                   = \"\>", 
   "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"\<\"I6\"\>", ",", "\<\"I3\"\>", ",", "\<\"I1\"\>", 
     ",", "\<\"I2\"\>"}], "}"}]}],
  SequenceForm[
  "fibre types                                   = ", {
   "I6", "I3", "I1", "I2"}],
  Editable->False]], "Print",
 CellChangeTimes->{4.003480991079576*^9},
 CellLabel->
  "During evaluation of \
In[659]:=",ExpressionUUID->"3c92ccab-5e88-4d3a-a594-eabafa39aa67"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"TotalEuler / ExpectedEuler                    = \"\>", 
   "\[InvisibleSpace]", 
