In[659]:=",ExpressionUUID->"e9c2c911-fece-4b72-bf9b-8bce9f4c7393"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"ECPFibreAtInfinity[fam6,d]                    = \"\>", 
   "\[InvisibleSpace]", 
   RowBox[{"\[LeftAssociation]", 
