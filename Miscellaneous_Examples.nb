Cell[CellGroupData[{

Cell["\<\
3.5  Reduced Tate pairing ECPTatePairingFp[n, P, Q, curve, field]\
\>", "Subsubsection",ExpressionUUID->"ddee7c2a-0bed-4284-b59d-b1b1661fa637"],

Cell["\<\
t_n(P,Q) = f_{n,P}(Q)^((q-1)/n), for P in E(F_q)[n], Q in E(F_q), n | q-1. \
Not alternating. Needs n | q-1, so here F_17 with n = 4 (or n = 2).\
\>", "Text",ExpressionUUID->"a188d921-c1e1-4c23-8ae3-ecd5a2e2add9"],

Cell[CellGroupData[{

Cell["\<\
(* n = 4, q = 17: (q-1)/n = 4 *)
tPQ = ECPTatePairingFp[4, {4, 3}, {5, 1}, {-1, 0}, 17];
Print[\"t_4[(4,3),(5,1)]                              = \", tPQ];   (* expect \
13 (a primitive 4th root: 13^2 = 16 = -1) *)
Print[\"t_4[(4,3),(5,1)]^4 mod 17                     = \", PowerMod[tPQ, 4, \
17]];   (* 1 *)
Print[\"t_4[(5,1),(4,3)]                              = \", \
ECPTatePairingFp[4, {5, 1}, {4, 3}, {-1, 0}, 17]];   (* expect 13 *)
Print[\"t_4[2P,Q]                                     = \", \
ECPTatePairingFp[4, ECPMultiplyFp[2, {4, 3}, {-1, 0}, 17], {5, 1}, {-1, 0}, \
17]];   (* expect 16 = t^2 (bilinearity) *)
(* Unlike the Weil pairing, P = Q is allowed and generally gives a \
non-trivial value; the function uses an auxiliary point if Q is a zero/pole \
of a Miller step *)
Print[\"t_4[(4,3),(4,3)]                              = \", \
ECPTatePairingFp[4, {4, 3}, {4, 3}, {-1, 0}, 17]];   (* no fixed expectation; \
compare with e_4[(4,3),(4,3)] = 1 *)
(* n must divide q-1: n = 3 does not divide 16, so a message asks for a field \
{p,r} with 3 | p^r - 1 *)
Print[\"ECPTatePairingFp[3,P,Q,E1,17]                 = \", \
ECPTatePairingFp[3, {4, 3}, {5, 1}, {-1, 0}, 17]];   (* $Failed + message *)\
\>", "Input",
 CellLabel->
  "In[587]:=",ExpressionUUID->"e2f78c4d-6ab8-4404-b3f1-f65ae3027024"],

