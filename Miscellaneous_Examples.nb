ECPWInvariants[Automatic]];   (* b2=0,b4=-2,b6=1,b8=-1,c4=48,c6=-216,Disc=37 *)
Print[\"ECPWeierstrassDiscriminant[Automatic]         = \", \
ECPWeierstrassDiscriminant[Automatic]];   (* 37 *)
Print[\"ECPJInvariant[Automatic]                      = \", \
ECPJInvariant[Automatic]];   (* 110592/37 = 48^3/37 *)\
\>", "Input",
