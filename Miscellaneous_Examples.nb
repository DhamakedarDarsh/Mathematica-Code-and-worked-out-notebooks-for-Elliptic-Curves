Cell[CellGroupData[{

Cell["5.1  Field arithmetic in F_25 = F_(5^2)", "Subsubsection",ExpressionUUID->"db93bb50-5698-407f-a7fc-75de97aa6d96"],

Cell["\<\
Elements are written 0 and g^k (k = 0..23), where g is the primitive element \
described by ECPFiniteFieldInfo[{5,2}].\
\>", "Text",ExpressionUUID->"abed602d-ca43-46ef-ba02-c3a5d5df9ba8"],

Cell[CellGroupData[{

Cell["\<\
Print[\"ECPFqMultiply[g^3,g^5,{5,2}]                  = \", \
ECPFqMultiply[g^3, g^5, {5, 2}]];   (* expect g^8 *)
Print[\"ECPFqInverse[g^5,{5,2}]                       = \", ECPFqInverse[g^5, \
{5, 2}]];   (* expect g^19, since g^24 = 1 *)
Print[\"  g^5 * inverse                               = \", \
ECPFqMultiply[g^5, ECPFqInverse[g^5, {5, 2}], {5, 2}]];   (* expect 1 *)
Print[\"ECPFqAdd[g,g^2,{5,2}]                         = \", ECPFqAdd[g, g^2, \
{5, 2}]];   (* some g^k (depends on the field polynomial) *)
Print[\"ECPFqAdd[g^12,1,{5,2}]                        = \", ECPFqAdd[g^12, 1, \
{5, 2}]];   (* expect 0, since g^12 = -1 *)
Print[\"ECPFqVector[g^7,{5,2}]                        = \", ECPFqVector[g^7, \
{5, 2}]];   (* {c0, c1} with g^7 = c0 + c1 g *)
Print[\"ECPFqElement[ECPFqVector[g^7,{5,2}],{5,2}]    = \", \
ECPFqElement[ECPFqVector[g^7, {5, 2}], {5, 2}]];   (* expect g^7 (round trip) \
*)\
\>", "Input",
 CellLabel->
  "In[619]:=",ExpressionUUID->"8ab0c680-7de2-4f6d-bd6f-d3e55be59d97"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
