Cell["\<\
6.2  Kodaira's table, Coulomb-branch dimensions and gauge algebras\
\>", "Subsubsection",ExpressionUUID->"7ab41473-62bc-4b75-b20b-791414992d4f"],

Cell[CellGroupData[{

Cell["\<\
Print[\"ECPKodairaType[{0,0,1}]                       = \", \
ECPKodairaType[{0, 0, 1}]];   (* {\"I1\", 1} *)
Print[\"ECPKodairaType[{0,0,6}]                       = \", \
ECPKodairaType[{0, 0, 6}]];   (* {\"I6\", 6} *)
Print[\"ECPKodairaType[{2,3,6}]                       = \", \
ECPKodairaType[{2, 3, 6}]];   (* {\"I0*\", 6} *)
Print[\"ECPKodairaType[{4,5,10}]                      = \", \
ECPKodairaType[{4, 5, 10}]];   (* {\"II*\", 10} *)
Print[\"ECPKodairaType[{4,6,12}]                      = \", \
ECPKodairaType[{4, 6, 12}]];   (* {\"non-minimal\", Indeterminate} *)
Print[\"ECPCoulombDimension[2]                        = \", \
ECPCoulombDimension[2]];   (* type II: 6/5 *)
Print[\"ECPCoulombDimension[6]                        = \", \
ECPCoulombDimension[6]];   (* type I0*: 2 *)
Print[\"ECPCoulombDimension[10]                       = \", \
ECPCoulombDimension[10]];   (* type II*: 6 *)
Print[\"ECPGaugeAlgebra[\"I3\",True]                    = \", \
ECPGaugeAlgebra[\"I3\", True]];   (* su(3) *)
Print[\"ECPGaugeAlgebra[\"I4\",False]                   = \", \
ECPGaugeAlgebra[\"I4\", False]];   (* sp(2) *)
Print[\"ECPGaugeAlgebra[\"IV*\",False]                  = \", \
ECPGaugeAlgebra[\"IV*\", False]];   (* f4 *)
Print[\"ECPGaugeAlgebra[\"II*\"]                        = \", \
ECPGaugeAlgebra[\"II*\"]];   (* e8 *)
Print[\"ECPGaugeAlgebra[\"I4\"]                         = \", \
ECPGaugeAlgebra[\"I4\"]];   (* split not given: an either/or string *)\
\>", "Input",
 CellLabel->
