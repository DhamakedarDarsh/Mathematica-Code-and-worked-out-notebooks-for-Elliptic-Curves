Cell[CellGroupData[{

Cell["PART 7 -- Cubics in characteristic 2 and 3 ", "Section",
 CellChangeTimes->{
  4.0034813320913315`*^9},ExpressionUUID->"ec241f94-e076-4fe1-ba24-\
95bd727dd560"],

Cell["\<\
ECPCubicToWeierstrassCharTwoThree needs a flex point. We scramble E2 \
(projectively y^2 z + y z^2 = x^3 - x z^2) by swapping x and z; the point \
[0:1:0] is still a flex. The Weierstrass model returned must have the same \
number of points as E2: 5 over F_2 and 7 over F_3.\
\>", "Text",ExpressionUUID->"1261800f-557f-47c0-b8ba-fd39ec7b873e"],

Cell[CellGroupData[{

Cell["\<\
Fsw = y^2 x + y x^2 - z^3 + z x^2;
w2 = ECPCubicToWeierstrassCharTwoThree[{0, 1, 0}, Fsw, 2];
Print[\"char 2 result                                 = \", w2];   (* \
Association with the coefficients, matrix and auxiliary points *)
c2 = w2[\"WeierstrassCoefficients\"];
Print[\"  #E(F_2) of the result                       = \", \
ECPSEAPointCount[c2, 2]];   (* expect 5 *)
w3 = ECPCubicToWeierstrassCharTwoThree[{0, 1, 0}, Fsw, 3];
c3 = w3[\"WeierstrassCoefficients\"];
Print[\"  #E(F_3) of the result                       = \", \
ECPSEAPointCount[c3, 3]];   (* expect 7 *)\
\>", "Input",
 CellLabel->
  "In[665]:=",ExpressionUUID->"531fb242-6c55-452e-8771-fe7a957bd3ac"],

