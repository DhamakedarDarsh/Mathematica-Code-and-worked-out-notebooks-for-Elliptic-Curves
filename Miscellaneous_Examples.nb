Cell[CellGroupData[{

Cell["4.4  Schoof's algorithm: ECPSchoofPointCount", "Subsubsection",ExpressionUUID->"99ef4f89-8ef0-4071-ac96-58712ab3c59c"],

Cell["\<\
ECPSchoofPointCount uses division polynomials and works far beyond the 10^6 \
limit of ECPSEAPointCount. For p = 3 mod 4, E1 is supersingular, so #E1(F_p) \
= p + 1.\
\>", "Text",ExpressionUUID->"d8256dd8-17ff-4c53-aaef-b464a02e74c4"],

Cell[CellGroupData[{

Cell["\<\
Print[\"ECPSchoofPointCount[{0,0,1,-1,0},10007]       = \", \
ECPSchoofPointCount[{0, 0, 1, -1, 0}, 10007]];   (* expect 9942 *)
Print[\"  agrees with ECPSEAPointCount                = \", \
ECPSchoofPointCount[{0, 0, 1, -1, 0}, 10007] == ECPSEAPointCount[{0, 0, 1, \
-1, 0}, 10007]];   (* True *)
Print[\"ECPSchoofPointCount[-1,0,1000003]             = \", \
ECPSchoofPointCount[-1, 0, 1000003]];   (* expect 1000004 (p = 3 mod 4, \
beyond the SEA limit) *)
Print[\"ECPSchoofPointCount[{0,0,1,-1,0},{101,1}]     = \", \
ECPSchoofPointCount[{0, 0, 1, -1, 0}, {101, 1}]];   (* expect 99 *)\
\>", "Input",
 CellLabel->
  "In[615]:=",ExpressionUUID->"c11b1c96-5f84-46cd-84dd-3eef3678ac13"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
