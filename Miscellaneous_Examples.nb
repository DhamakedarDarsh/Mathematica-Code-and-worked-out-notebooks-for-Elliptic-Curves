Cell[CellGroupData[{

Cell["6.3  Tate forms and single fibres", "Subsubsection",ExpressionUUID->"732b504d-fd9d-4146-978a-28f327edac2a"],

Cell[CellGroupData[{

Cell["\<\
su5 = ECPTateForm[{0, 1, 2, 3, 5}, t];
Print[\"ECPTateForm[{0,1,2,3,5},t]                    = \", su5];   (* {1+2t, \
(1+3t) t, (3+4t) t^2, (5+5t) t^3, (7+6t) t^5} *)
Print[\"ECPFibreAt[su5,t,0]                           = \", ECPFibreAt[su5, \
t, 0]];   (* Type I5, split, GaugeAlgebra su(5) *)
Print[\"ECPFibreAt[ECPTateForm[E8],t,0] type          = \", \
ECPFibreAt[ECPTateForm[{1, 2, 3, 4, 5}, t], t, 0][\"Type\"]];   (* II* *)\
\>", "Input",
 CellLabel->
  "In[655]:=",ExpressionUUID->"9e87b3d6-8b53-42a7-ab3e-0f3a1319e8bf"],

