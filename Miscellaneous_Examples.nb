Cell[CellGroupData[{

Cell["5.3  Koblitz embedding and ElGamal on E2 over F_999983", "Subsubsection",ExpressionUUID->"41afb224-4a55-4ca9-8eaf-751691e0b2ac"],

Cell[CellGroupData[{

Cell["\<\
pE = 999983; s = 123457;
G = ECPFindPointFp[7, {0, 0, 1, -1, 0}, pE];
Print[\"G = ECPFindPointFp[7,E2,999983]               = \", G];   (* a point \
whose x encodes 7 (x = 700 + j, j < 100) *)
nG = ECPFindPointOrderFp[G, {0, 0, 1, -1, 0}, pE];
Print[\"order of G                                    = \", nG];   (* divides \
#E2(F_999983) = 1001455 *)
pub = ECPMultiplyFp[s, G, {0, 0, 1, -1, 0}, pE];
cipher = ECPElGamalEncodeFp[4321, {G, pub}, {0, 0, 1, -1, 0}, pE, nG];
Print[\"ECPElGamalEncodeFp[4321,...]                  = \", cipher];   (* \
{C1, C2} *)
Print[\"ECPElGamalDecodeFp[s,cipher,E2,pE]            = \", \
ECPElGamalDecodeFp[s, cipher, {0, 0, 1, -1, 0}, pE]];   (* expect 4321 *)
Print[\"ECPFindPointFp[20000,E2,999983]               = \", \
ECPFindPointFp[20000, {0, 0, 1, -1, 0}, pE]];   (* $Failed + message: m*kappa \
+ kappa >= p *)\
\>", "Input",
 CellLabel->
  "In[630]:=",ExpressionUUID->"73b65727-48da-4618-8b26-46f97318048e"],

