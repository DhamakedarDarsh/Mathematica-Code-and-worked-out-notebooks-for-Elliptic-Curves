Cell[CellGroupData[{

Cell["2.3  Minimality, local reduction and isomorphisms", "Subsubsection",ExpressionUUID->"7a4ced29-4f55-4310-9b26-effa82e0783a"],

Cell[CellGroupData[{

Cell["\<\
Print[\"ECPIsMinimal[Automatic]                       = \", \
ECPIsMinimal[Automatic]];   (* True: Delta = 37 squarefree *)
Print[\"ECPMinimalQ[Automatic]                        = \", \
ECPMinimalQ[Automatic]];   (* True *)
Print[\"ECPMinimalModel[Automatic]                    = \", \
ECPMinimalModel[Automatic]];   (* Transformation {1,0,0,0} *)
Print[\"ECPFindLocalReduction[{0,0,1,-1,0},37]        = \", \
ECPFindLocalReduction[{0, 0, 1, -1, 0}, 37]];   (* None *)
(* Inflate E2 with u = 1/2 to get a non-minimal integral model {0,0,8,-16,0} *)
nonMinE2 = ECPTransformWeierstrass[{0, 0, 1, -1, 0}, {1/2, 0, 0, 0}];
Print[\"ECPTransformWeierstrass[E2,{1/2,0,0,0}]       = \", nonMinE2];   (* \
expect {0,0,8,-16,0} *)
Print[\"ECPIsMinimal[nonMinE2]                        = \", \
ECPIsMinimal[nonMinE2]];   (* False *)
Print[\"ECPIsMinimalShort[nonMinE2]                   = \", \
ECPIsMinimalShort[nonMinE2]];   (* False (long input -> true Weierstrass \
test) *)
Print[\"ECPFindLocalReduction[nonMinE2,2]             = \", \
ECPFindLocalReduction[nonMinE2, 2]];   (* expect {2,0,0,0} *)
Print[\"ECPMinimalModel[nonMinE2]                     = \", \
ECPMinimalModel[nonMinE2]];   (* recovers {0,0,1,-1,0}, Transformation u = 2 *)
Print[\"ECPMinimalModelShort[nonMinE2]                = \", \
ECPMinimalModelShort[nonMinE2]];   (* long input dispatches to \
ECPMinimalModel *)
Print[\"ECPComposeTransformations[{1/2,0,0,0},{2,0,0,0}]= \", \
ECPComposeTransformations[{1/2, 0, 0, 0}, {2, 0, 0, 0}]];   (* expect \
{1,0,0,0} *)
(* (4,0) lies on nonMinE2: 0 = 4^3 - 16*4 *)
Print[\"ECPOnCurveQ[{4,0},nonMinE2]                   = \", ECPOnCurveQ[{4, \
0}, nonMinE2]];   (* True *)
(* v20: ECPToLongCoordinates[pt', curve, T] takes a point of \
ECPTransformWeierstrass[curve, T] and returns the point of curve. Here curve \
= E2 and T = {1/2,0,0,0}, so ECPTransformWeierstrass[E2, T] = nonMinE2 \
contains (4,0) and the answer is (1,0) on E2. *)
Print[\"ECPToLongCoordinates[{4,0},E2,{1/2,0,0,0}]    = \", \
ECPToLongCoordinates[{4, 0}, {0, 0, 1, -1, 0}, {1/2, 0, 0, 0}]];   (* expect \
{1,0}: the point on E2 (v19 checks the point lies on the curve given) *)
mp = ECPToMinimalPoint[{1, 0}, {1/2, 0, 0, 0}];
Print[\"ECPToMinimalPoint[{1,0},{1/2,0,0,0}]          = \", mp];   (* expect \
{4,0} *)
Print[\"ECPFromMinimalPoint[mp,{1/2,0,0,0}]           = \", \
ECPFromMinimalPoint[mp, {1/2, 0, 0, 0}]];   (* back to {1,0} *)\
\>", "Input",
 CellLabel->
  "In[488]:=",ExpressionUUID->"3d2ee88a-5112-4b51-9903-b87919a69e67"],

Cell[CellGroupData[{

Cell[BoxData[
