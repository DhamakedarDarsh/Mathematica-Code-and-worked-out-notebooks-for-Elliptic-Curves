Cell[CellGroupData[{

Cell["3.3  Weil pairing ECPWeilPairingFp[n, P, Q, curve, field]", \
"Subsubsection",ExpressionUUID->"ff79b389-e250-48ba-a1de-c5af736dfeb6"],

Cell["\<\
e_n(P,Q) = (-1)^n f_{n,P}(Q) / f_{n,Q}(P) is an n-th root of unity: bilinear, \
alternating (e(P,P) = 1), non-degenerate. Dependent points give 1.\
\>", "Text",ExpressionUUID->"128fd782-3d9f-448e-913c-2afde02319d0"],

Cell[CellGroupData[{

Cell["\<\
(* n = 2 over F_5: independent 2-torsion points give -1 = 4 *)
Print[\"ECPWeilPairingFp[2,{0,0},{1,0},{-1,0},5]      = \", \
ECPWeilPairingFp[2, {0, 0}, {1, 0}, {-1, 0}, 5]];   (* expect 4 (= -1) *)
Print[\"ECPWeilPairingFp[2,{0,0},{4,0},{-1,0},5]      = \", \
ECPWeilPairingFp[2, {0, 0}, {4, 0}, {-1, 0}, 5]];   (* expect 4 *)
Print[\"ECPWeilPairingFp[2,{0,0},{0,0},{-1,0},5]      = \", \
ECPWeilPairingFp[2, {0, 0}, {0, 0}, {-1, 0}, 5]];   (* alternating: 1 *)
(* n = 4 over F_17 *)
e = ECPWeilPairingFp[4, {4, 3}, {5, 1}, {-1, 0}, 17];
Print[\"e_4[(4,3),(5,1)]                              = \", e];   (* expect 4 \
-- a primitive 4th root of unity mod 17 (4^2 = -1) *)
Print[\"e_4[(5,1),(4,3)]                              = \", \
ECPWeilPairingFp[4, {5, 1}, {4, 3}, {-1, 0}, 17]];   (* expect 13 = 4^(-1): \
antisymmetry e(Q,P) = e(P,Q)^(-1) *)
Print[\"e_4[(4,3),(4,3)]                              = \", \
ECPWeilPairingFp[4, {4, 3}, {4, 3}, {-1, 0}, 17]];   (* 1 *)
Print[\"e_4[2P,Q]                                     = \", \
ECPWeilPairingFp[4, ECPMultiplyFp[2, {4, 3}, {-1, 0}, 17], {5, 1}, {-1, 0}, \
17]];   (* expect 16 = e^2 (bilinearity) *)
Print[\"Check e^2 mod 17                              = \", PowerMod[e, 2, \
17]];   (* 16 *)
Print[\"e_4[(4,3),(4,14)]                             = \", \
ECPWeilPairingFp[4, {4, 3}, {4, 14}, {-1, 0}, 17]];   (* expect 1: (4,14) = \
-(4,3) is dependent *)
(* A point of smaller order is reduced to its exact order *)
Print[\"e_4[(4,3),(1,0)]                              = \", \
ECPWeilPairingFp[4, {4, 3}, {1, 0}, {-1, 0}, 17]];   (* expect 16 = -1 *)\
\>", "Input",
 CellLabel->
  "In[564]:=",ExpressionUUID->"bdfdcf01-737c-4412-be11-864fcbe1a3ce"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"ECPWeilPairingFp[2,{0,0},{1,0},{-1,0},5]      = \"\>", 
   "\[InvisibleSpace]", "4"}],
  SequenceForm["ECPWeilPairingFp[2,{0,0},{1,0},{-1,0},5]      = ", 4],
  Editable->False]], "Print",
