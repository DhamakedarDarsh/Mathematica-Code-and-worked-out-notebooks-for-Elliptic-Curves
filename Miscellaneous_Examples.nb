Cell[CellGroupData[{

Cell["3.2  Miller's function ECPMillerFp[n, P, Q, curve, field]", \
"Subsubsection",ExpressionUUID->"ff409749-bd6a-48d3-8e36-a57a4ce54679"],

Cell["\<\
ECPMillerFp evaluates f_{n,P}(Q) with div f = n(P) - ([n]P) - (n-1)(O). Q \
must not be Infinity, and must not be a zero or pole of an intermediate \
function (e.g. Q in the group generated by P).\
\>", "Text",ExpressionUUID->"e1cc2633-d958-4362-ac28-59abbc2af833"],

Cell[CellGroupData[{

Cell["\<\
(* F_5: P=(0,0) has order 2. f_{2,P} is the vertical line x - 0, so f(Q) = \
x(Q). *)
Print[\"ECPMillerFp[2,{0,0},{2,1},{-1,0},5]           = \", ECPMillerFp[2, \
{0, 0}, {2, 1}, {-1, 0}, 5]];   (* expect 2 *)
(* P=(2,1) has order 4 *)
Print[\"ECPMillerFp[4,{2,1},{1,0},{-1,0},5]           = \", ECPMillerFp[4, \
{2, 1}, {1, 0}, {-1, 0}, 5]];   (* expect 4 *)
Print[\"ECPMillerFp[4,{2,1},{3,2},{-1,0},5]           = \", ECPMillerFp[4, \
{2, 1}, {3, 2}, {-1, 0}, 5]];   (* expect 3 *)
(* Q = (0,0) = 2P lies in <P>: an intermediate function vanishes, so a \
message and $Failed are expected *)
Print[\"ECPMillerFp[4,{2,1},{0,0},{-1,0},5]           = \", ECPMillerFp[4, \
{2, 1}, {0, 0}, {-1, 0}, 5]];   (* $Failed + message *)
(* F_17, order-4 point P=(4,3) and Q=(5,1) *)
Print[\"ECPMillerFp[4,{4,3},{5,1},{-1,0},17]          = \", ECPMillerFp[4, \
{4, 3}, {5, 1}, {-1, 0}, 17]];   (* expect 3 *)\
\>", "Input",
 CellLabel->
  "In[555]:=",ExpressionUUID->"7914b534-3b82-4307-9c54-b010088c2d2e"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"ECPMillerFp[2,{0,0},{2,1},{-1,0},5]           = \"\>", 
   "\[InvisibleSpace]", "2"}],
  SequenceForm["ECPMillerFp[2,{0,0},{2,1},{-1,0},5]           = ", 2],
  Editable->False]], "Print",
