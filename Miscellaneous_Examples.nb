      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1", ",", 
        RowBox[{"-", "1"}], ",", "0"}], "}"}]}], ",", 
     RowBox[{"\<\"Equation\"\>", "\[Rule]", 
      RowBox[{
       RowBox[{"y", "+", 
        SuperscriptBox["y", "2"]}], "\[Equal]", 
       RowBox[{
        RowBox[{"-", "x"}], "+", 
        SuperscriptBox["x", "3"]}]}]}], ",", 
