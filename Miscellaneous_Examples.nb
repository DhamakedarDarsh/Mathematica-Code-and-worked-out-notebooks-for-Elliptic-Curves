Cell["4.2  Prime divisor counts and the proven rank bound", "Subsubsection",ExpressionUUID->"890f1c78-81b0-4c47-a06b-64c6e4144f1b"],

Cell[CellGroupData[{

Cell["\<\
Print[\"ECPPrimeDivisorCount[30]                      = \", \
ECPPrimeDivisorCount[30]];   (* expect 3 *)
Print[\"ECPPrimeDivisorCount[-1]                      = \", \
ECPPrimeDivisorCount[-1]];   (* expect 0 *)
Print[\"ECPPrimeDivisorCount[{-1,0}]                  = \", \
ECPPrimeDivisorCount[{-1, 0}]];   (* nu(Delta) = nu(64) = 1 *)
Print[\"ECPPrimeDivisorCount[{0,0,1,-1,0}]            = \", \
ECPPrimeDivisorCount[{0, 0, 1, -1, 0}]];   (* nu(37) = 1 *)
Print[\"ECPRankBound[{-1,0},\"Details\"]                = \", \
ECPRankBound[{-1, 0}, \"Details\"]];   (* Bound 0 with the candidate methods \
listed *)\
\>", "Input",
 CellLabel->
  "In[608]:=",ExpressionUUID->"42a0a100-3526-4ae7-9e8a-c910dedce4ac"],

