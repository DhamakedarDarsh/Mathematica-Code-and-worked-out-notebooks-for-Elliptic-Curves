Cell[CellGroupData[{

Cell["1.3  Group law", "Subsubsection",ExpressionUUID->"9e757c95-9cf2-4f5c-bb86-6c04e52cf489"],

Cell[CellGroupData[{

Cell["\<\
Print[\"ECPPointQ[y^2-(x^3-x),0,0]                    = \", ECPPointQ[{0, 0}, \
y^2 - (x^3 - x)]];   (* True (v19: point first, curve second) *)
Print[\"ECPOnCurveQ[{0,0},{-1,0}]                     = \", ECPOnCurveQ[{0, \
0}, {-1, 0}]];   (* True *)
Print[\"ECPOnCurveQ[{2,3},{-1,0}]                     = \", ECPOnCurveQ[{2, \
3}, {-1, 0}]];   (* False *)
(* The three nonzero 2-torsion points sum to O, so (0,0)+(1,0) must be the \
third one, (-1,0). *)
Print[\"ECPAdd[{0,0},{1,0},{-1,0}]                    = \", ECPAdd[{0, 0}, \
{1, 0}, {-1, 0}]];   (* expect {-1,0} *)
Print[\"ECPMultiply[2,{0,0},{-1,0}]                   = \", ECPMultiply[2, \
{0, 0}, {-1, 0}]];   (* expect Infinity: (0,0) has order 2 *)
Print[\"ECPFindPointOrder[{0,0},{-1,0}]               = \", \
ECPFindPointOrder[{0, 0}, {-1, 0}]];   (* 2  (curve is now an argument, not \
-1,0) *)
Print[\"ECPFindPointOrder[{0,0},{-1,0},12]            = \", \
ECPFindPointOrder[{0, 0}, {-1, 0}, 12]];   (* 2, explicit maxOrder *)
Print[\"ECPPointOrder[{0,0},{-1,0}]                   = \", ECPPointOrder[{0, \
0}, {-1, 0}]];   (* 2 *)
Print[\"ECPPointOrder[{1,0},{-1,0}]                   = \", ECPPointOrder[{1, \
0}, {-1, 0}]];   (* 2 *)
Print[\"ECPBachetDuplication[x,{-1,0}]                = \", \
ECPBachetDuplication[x, {-1, 0}]];   (* x(2P) as a rational function of x *)
Print[\"ECPBachetDuplication[{0,0},{-1,0}]            = \", \
ECPBachetDuplication[{0, 0}, {-1, 0}]];   (* expect Infinity *)\
\>", "Input",
 CellLabel->
  "In[427]:=",ExpressionUUID->"84fa6a8d-5b6d-4f34-b2a1-5455efdc4c13"],

