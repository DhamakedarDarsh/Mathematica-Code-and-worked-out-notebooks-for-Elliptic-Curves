Cell[CellGroupData[{

Cell["Exercises - Chapter XI", "Subsection",ExpressionUUID->"83ed9754-81ab-4edb-9d58-fac8f0e5924b"],

Cell[CellGroupData[{

Cell["Exercise 11.1", "Subsubsection",ExpressionUUID->"1c2892b4-745e-474a-949e-76ad94f67de0"],

Cell["\<\
(a) Compute [23](195, 9) on y^2 = x^3 + 143x + 367 over F_613. (b) Compute \
[3211](2898, 439) on y^2 = x^3 + 1541x + 1335 over F_3221. Answer: (485, 573) \
and (243, 1875).\
\>", "Text",ExpressionUUID->"1f1dcf0e-107d-416c-84a2-b36bfcd58993"],

