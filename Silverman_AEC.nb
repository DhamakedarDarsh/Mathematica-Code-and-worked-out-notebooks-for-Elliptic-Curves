Cell[BoxData["3"], "Output",
 CellChangeTimes->{4.003445545702117*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"7d273785-e533-4cab-ab0f-cd7534e5ba33"]
}, Open  ]],

