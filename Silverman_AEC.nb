Cell["\<\
Table[{d, ECPJInvariant[{-2 d^2, d^3}], ECPTorsionSubgroup[{-2 d^2, \
d^3}][\"Structure\"]}, {d, {1, 2, 3, 5, 6, 7}}] // TableForm\
\>", "Input",
 CellLabel->"In[86]:=",ExpressionUUID->"597cf5fd-2085-4bb9-ac78-245df4f379fe"],

