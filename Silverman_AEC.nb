Cell[CellGroupData[{

Cell["Exercise 11.16", "Subsubsection",ExpressionUUID->"8d9a3abb-6524-41f1-893a-4cd618eb45d3"],

Cell["\<\
On the curve of Example 8.3, P' = (617, 5) and Q' = (121, 244) are in E[5], \
with P = 2P' and Q = 4Q'. Then e_5(P', Q') = 512 and 512^8 = 242 mod 631.\
\>", "Text",ExpressionUUID->"8ffda364-0670-4836-b0a8-be6b3f1fed71"],

