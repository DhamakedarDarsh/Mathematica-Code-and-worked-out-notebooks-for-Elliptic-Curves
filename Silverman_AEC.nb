Cell[CellGroupData[{

Cell["Example (8.4)", "Subsection",ExpressionUUID->"abe65833-33c0-4636-9a47-0f97f4ef590b"],

Cell["\<\
y^2 = x^3 + 16 is not minimal at 2. The substitution x = 4x', y = 8y' + 4 \
gives the minimal equation y^2 + y = x^3.\
\>", "Text",ExpressionUUID->"1727b40e-44b1-4870-9404-5fc32542886e"],

