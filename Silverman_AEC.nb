Cell[CellGroupData[{

Cell["Exercise 5.12", "Subsubsection",ExpressionUUID->"31632a77-e453-4cbf-aa23-036146137834"],

Cell["\<\
For y^2 = x^3 + x, #E(F_p) is divisible by 4 for every odd prime p.\
\>", "Text",ExpressionUUID->"f002bd6e-1596-4215-a064-ec70944950ed"],

