 RowBox[{"{", "\[Infinity]", "}"}]], "Output",
 CellChangeTimes->{4.0034455474403553`*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"22fe4ccf-a4e0-413f-9f8a-d2f318b46f8a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example (3.3.2)", "Subsection",ExpressionUUID->"b5c23453-0b34-4214-adac-fb91eac0ade7"],

Cell["\<\
E : y^2 = x^3 + 3 has #E(F_5) = 6 and #E(F_7) = 13, so E(Q) has no torsion \
and (1, 2) has infinite order.\
\>", "Text",ExpressionUUID->"76306405-63fe-4f2e-8036-d1c3a3ce8d2e"],

