Cell[CellGroupData[{

Cell["Exercises - Chapter VIII", "Subsection",ExpressionUUID->"72fa65a9-e92e-409a-99dc-53d34feaa2c9"],

Cell[CellGroupData[{

Cell["Exercise 8.2", "Subsubsection",ExpressionUUID->"452f469a-c0f7-43de-8e8f-00740b27218f"],

Cell["\<\
For E_d : y^2 = x^3 - d^2 x, the rank is at most 2 nu(2d). For d = 5, 6, 7 \
(congruent numbers) the rank is 1.\
\>", "Text",ExpressionUUID->"3bf4f1c4-c852-4ba6-841e-d57c60c4cf42"],

