Cell[CellGroupData[{

Cell["Example (5.2)", "Subsection",ExpressionUUID->"bde4136b-3544-4978-b141-a711a60e17a2"],

Cell["\<\
For p >= 5: E1 : y^2 = x^3 + p x^2 + 1 has good reduction at p, E2 : y^2 = \
x^3 + x^2 + p has (split) multiplicative reduction, and E3 : y^2 = x^3 + p \
has additive reduction. Take p = 5.\
\>", "Text",ExpressionUUID->"f0563c07-045e-43cd-8c4b-cce0caefca0d"],

