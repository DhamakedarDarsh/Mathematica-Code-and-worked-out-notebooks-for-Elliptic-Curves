Cell["\<\
ECPBachetDuplication[ECPBachetDuplication[-2, {0, 17}], {0, 17}]\
\>", "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"96bf69ff-08a3-482e-9155-549715ffdf64"],

