Cell[CellGroupData[{

Cell["Example (6.7)", "Subsection",ExpressionUUID->"5f7f3426-190d-46dc-9204-0fa507e6918f"],

Cell["\<\
On E : y^2 = x^3 + 19x + 112 over F_127 with P = (106, 72) and Q = (12, 121), \
the answer is Q = [46]P. (The book calls this curve supersingular, but \
#E(F_127) = 127, so it is anomalous.)\
\>", "Text",ExpressionUUID->"d801fe35-ad4f-4152-bf29-16acfb67b4f2"],

