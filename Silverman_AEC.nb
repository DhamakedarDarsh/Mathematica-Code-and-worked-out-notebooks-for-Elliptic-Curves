Cell[CellGroupData[{

Cell["Example (1.5)", "Subsection",ExpressionUUID->"24503b85-4f47-430e-a515-50d7036dd01a"],

Cell["\<\
E : y^2 = x^3 - 12x^2 + 20x. E(Q) contains E[2] = {O, (0, 0), (2, 0), (10, \
0)} and the points (1, -3), (20, 60), (18, -48), (10/9, -80/27); the book \
shows E(Q) = Z x Z/2 x Z/2.\
\>", "Text",ExpressionUUID->"f9b1fb3b-ab7a-4d1d-9659-7ae5043c1639"],

