Cell[CellGroupData[{

Cell["Exercise 3.27", "Subsubsection",ExpressionUUID->"42f6b6e0-4c42-4e34-b30e-0d750e2f6524"],

Cell["\<\
The map F_2 with x(2P) = F_2(x(P)) is Bachet's duplication formula. For y^2 = \
x^3 + 17 it is (x^4 - 136x)/(4(x^3 + 17)), and F_2(F_2(x)) = F_4(x).\
\>", "Text",ExpressionUUID->"19d00930-f5b1-41e5-ae92-86894f6ca372"],

Cell[CellGroupData[{

Cell["ECPBachetDuplication[x, {0, 17}]", "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"0013a724-c806-47a8-9dc4-51db6edb919e"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", "136"}], " ", "x"}], "+", 
   SuperscriptBox["x", "4"]}], 
  RowBox[{"4", " ", 
   RowBox[{"(", 
    RowBox[{"17", "+", 
     SuperscriptBox["x", "3"]}], ")"}]}]]], "Output",
 CellChangeTimes->{4.0034455458521338`*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"5638a46b-af7a-477d-94de-32a4cffef53e"]
}, Open  ]],

