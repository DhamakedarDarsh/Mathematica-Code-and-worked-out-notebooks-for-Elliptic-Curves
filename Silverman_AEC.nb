Cell["Chapter III - The Geometry of Elliptic Curves", "Section",ExpressionUUID->"fe845dc8-75ba-4e44-90d0-afe2a6d5bae5"],

Cell[CellGroupData[{

Cell["Example (2.4)", "Subsection",ExpressionUUID->"b7178873-316b-4114-9338-6d4a4976d030"],

Cell["\<\
The curve E : y^2 = x^3 + 17 has the integral points P1 = (-2, 3), P2 = (-1, \
4), P3 = (2, 5), P4 = (4, 9), P5 = (8, 23), P6 = (43, 282), P7 = (52, 375), \
P8 = (5234, 378661), and the book notes P5 = -2P1, P4 = P1 - P3, 3P1 - P3 = \
P7, together with 2P2 = (137/64, -2651/512) and P2 + P3 = (-8/9, -109/27).\
\>", "Text",ExpressionUUID->"7880d194-b48a-41dc-989b-5c4b343aeada"],

