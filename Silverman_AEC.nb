Cell["The Arithmetic of Elliptic Curves, 2 nd Edition, Silverman", "Title",
 CellChangeTimes->{{4.003463152073439*^9, 
  4.0034631727970304`*^9}},ExpressionUUID->"765e85f3-a19d-4b63-a42d-\
