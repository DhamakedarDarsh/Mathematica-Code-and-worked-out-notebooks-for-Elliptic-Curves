Cell[CellGroupData[{

Cell["Exercise 11.18", "Subsubsection",ExpressionUUID->"9002ca22-85f8-414f-bf3e-e4356645b2aa"],

Cell["\<\
For a supersingular curve over F_p and N dividing p + 1, E[N] lies in \
E(F_(p^2)). For y^2 = x^3 + x and p = 11: E(F_121) = Z/12 x Z/12.\
\>", "Text",ExpressionUUID->"d586a0c9-6563-4fa9-b2ad-f4fae03e5e2a"],

