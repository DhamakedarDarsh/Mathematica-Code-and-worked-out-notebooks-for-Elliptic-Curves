Cell[CellGroupData[{

Cell["Example (4.6)", "Subsection",ExpressionUUID->"1880a35f-6b15-493c-af27-23dbdd93c6c2"],

Cell["\<\
The curve y^2 + y = x^3 - x^2 - 10x - 20 has j = -2^12 31^3/11^5. Among the \
primes p < 100 (other than the bad prime 11) it is supersingular only for p = \
2, 19, 29, i.e. a_p = p + 1 - #E(F_p) is divisible by p.\
\>", "Text",ExpressionUUID->"c6cf12f8-b83d-42a6-bf9d-bf4976fe8feb"],

Cell[CellGroupData[{

Cell["ECPJInvariant[{0, -1, 1, -10, -20}]", "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"5ae2509d-40ba-4b5a-8024-a5b2eff6965c"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox["122023936", "161051"]}]], "Output",
 CellChangeTimes->{4.0034455460254135`*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"7c89b93f-d749-4743-ba3d-3c1b208cffa9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ECPWeierstrassDiscriminant[{0, -1, 1, -10, -20}]", "Input",
