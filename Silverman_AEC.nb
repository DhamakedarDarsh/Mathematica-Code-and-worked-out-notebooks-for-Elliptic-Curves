Cell[CellGroupData[{

Cell["Exercise 9.11(b)", "Subsubsection",ExpressionUUID->"de6d1e5d-b27c-4ba6-bcd6-c973d231029a"],

Cell["\<\
Find the integral points on y^2 = x^3 - p for p = 11, 19, 43, 67, 163. \
Answer: (3, 4) and (15, 58) for p = 11; (7, 18) for p = 19; none for p = 43; \
(23, 110) for p = 67; none for p = 163 (and the negatives of y).\
\>", "Text",ExpressionUUID->"34525396-c7f9-4f78-8176-a84fae3772c8"],

