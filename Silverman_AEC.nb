Cell["\<\
With x(nP) = a_n/d_n^2 for P = (0, 0) on y^2 + y = x^3 - x, the sequence d_n \
is 1, 1, 1, 1, 2, 1, 3, 5, 7, 4, 23, 29, 59, 129, 314, 65, and d_m divides \
d_n whenever m divides n.\
\>", "Text",ExpressionUUID->"ca3ce7b5-7ff9-448d-8ffa-b61b707d03f1"],

Cell[CellGroupData[{

Cell["\<\
Table[Sqrt[Denominator[ECPMultiply[n, {0, 0}, {0, 0, 1, -1, 0}][[1]]]], {n, \
1, 16}]\
\>", "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"3364389b-7774-42ba-adb8-e525caeff034"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "1", ",", "1", ",", "1", ",", "2", ",", "1", ",", "3", ",", "5", 
   ",", "7", ",", "4", ",", "23", ",", "29", ",", "59", ",", "129", ",", 
   "314", ",", "65"}], "}"}]], "Output",
 CellChangeTimes->{4.00344574769427*^9},
 CellLabel->"Out[98]=",ExpressionUUID->"22111ab7-cf30-40ba-8e9c-7811a645476f"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Closed]],

