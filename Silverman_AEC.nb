Cell[CellGroupData[{

Cell["Chapter XI - Algorithmic Aspects of Elliptic Curves", "Section",ExpressionUUID->"8ae6384f-7576-421a-9592-b46f8f95443d"],

Cell[CellGroupData[{

Cell["Example (2.5)", "Subsection",ExpressionUUID->"4e7160c1-f9f1-4912-ad7d-4ca95b3ce66e"],

Cell["\<\
Lenstra's algorithm factors 6887 = 71 . 97 with E : y^2 = x^3 + 14x + 19 and \
P = (1512, 3166): computing [7!]P fails modulo 71. The reason is that the \
order of E(F_71) has only small prime factors.\
\>", "Text",ExpressionUUID->"3077286b-12ac-4e22-8e2c-dd1d0288eebc"],

Cell[CellGroupData[{

Cell["FactorInteger[6887]", "Input",
 CellLabel->
  "In[136]:=",ExpressionUUID->"46cbb73b-96b5-40f9-9531-249162d3273f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"71", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"97", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.0034467061722517`*^9},
 CellLabel->
  "Out[136]=",ExpressionUUID->"35b25df7-68d8-401f-a1f6-ede8b3616081"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ECPSEAPointCount[{14, 19}, 71] // FactorInteger", "Input",
 CellLabel->
  "In[137]:=",ExpressionUUID->"04bfb328-2c63-403b-9f95-9f32cb6abd03"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"3", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"7", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.0034467062356043`*^9},
 CellLabel->
  "Out[137]=",ExpressionUUID->"d277d794-6610-4107-bf3f-cdcd9b77d8ea"]
