Cell[CellGroupData[{

Cell["Exercise 11.13", "Subsubsection",ExpressionUUID->"f2b59aa5-48fb-4548-bfd6-5d6d104027d0"],

Cell["\<\
Solve Q = [m]P: (a) y^2 = x^3 + 442x + 211 over F_541, P = (238, 345), Q = \
(180, 148); (b) y^2 = x^3 + 1356x + 1654 over F_7919, P = (6007, 296), Q = \
(2821, 6396); (c) y^2 = x^3 + 25780x + 74070 over F_104729, P = (6588, \
76182), Q = (14624, 59879). Answer: m = 50, 6062, 62354. Part (c) takes a \
minute or two.\
\>", "Text",ExpressionUUID->"fce3b8ee-d0ee-49f5-ad34-775fd7ebae5a"],

Cell[CellGroupData[{

Cell["\<\
Select[Range[1, 600], ECPMultiplyFp[#, {238, 345}, {442, 211}, 541] === {180, \
148} &, 1]\
