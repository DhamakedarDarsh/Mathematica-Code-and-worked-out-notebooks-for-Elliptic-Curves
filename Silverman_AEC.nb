  RowBox[{
   RowBox[{"\<\"MinimalCoefficients\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "0", ",", 
      RowBox[{"-", "1"}], ",", "0"}], "}"}]}], ",", 
   RowBox[{"\<\"Equation\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{
      RowBox[{"x", " ", "y"}], "+", 
