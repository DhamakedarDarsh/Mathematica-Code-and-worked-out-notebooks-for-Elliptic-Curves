Cell[CellGroupData[{

Cell["Chapter VII - Elliptic Curves over Local Fields", "Section",ExpressionUUID->"16b2b866-41b7-492c-84ab-f2062ed370b7"],

Cell[CellGroupData[{

Cell["Example (1.2)", "Subsection",ExpressionUUID->"6f09c5ba-7d1f-40fe-9204-99bbcfc80d9a"],

Cell["\<\
The curve y^2 + xy + y = x^3 + x^2 + 22x - 9 has Delta = -2^15 5^2 and c4 = \
-5 . 211, so the equation is minimal at every prime.\
\>", "Text",ExpressionUUID->"737148a6-1e98-4155-a4f1-00aae0ff9c38"],

Cell[CellGroupData[{

Cell["\<\
ECPWeierstrassDiscriminant[{1, 1, 1, 22, -9}] // FactorInteger\
\>", "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"d2e1d10c-0209-487d-85ab-6697da8b292e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "15"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "2"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.003445547283041*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"a98ef8b7-4026-4bca-a4ca-98308d437725"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ECPIsMinimal[{1, 1, 1, 22, -9}]", "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"33c12096-a7c2-4378-9e29-4c4da82f4d97"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{4.0034455473154106`*^9},
 CellLabel->"Out[43]=",ExpressionUUID->"a509286f-6648-4d1a-9cfe-2c1b5950ef78"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ECPJInvariant[{1, 1, 1, 22, -9}]", "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"11f8a6f9-9944-4eb5-9c10-d9d0832e8f36"],

Cell[BoxData[
 FractionBox["46969655", "32768"]], "Output",
 CellChangeTimes->{4.003445547335594*^9},
 CellLabel->"Out[44]=",ExpressionUUID->"f4689a9b-fc00-4f37-94bd-6ae0975f5157"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example (3.3.1)", "Subsection",ExpressionUUID->"aee39605-c04e-4b17-b5db-0f5ec9172fd5"],

Cell["\<\
E : y^2 + y = x^3 - x + 1 has Delta = -13 . 47, so it is nonsingular mod 2, \
and E(F_2) = {O}. Hence E(Q) has no torsion.\
\>", "Text",ExpressionUUID->"924606dc-99fd-46d4-ac88-85ec16479443"],

Cell[CellGroupData[{

Cell["ECPWeierstrassDiscriminant[{0, 0, 1, -1, 1}]", "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"4b62ed47-128c-453d-9661-aced1470a2b7"],

Cell[BoxData[
 RowBox[{"-", "611"}]], "Output",
 CellChangeTimes->{4.003445547375211*^9},
 CellLabel->"Out[45]=",ExpressionUUID->"f09caf25-7b3f-4728-b79e-c6c854ca27f3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ECPSEAPointCount[{0, 0, 1, -1, 1}, 2]", "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"14146230-0254-46d4-bcde-b7aee62548ec"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{4.0034455474067907`*^9},
 CellLabel->"Out[46]=",ExpressionUUID->"6a0281e2-9689-4265-aa8e-e4e537182865"]
}, Open  ]],

