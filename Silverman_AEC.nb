Cell[CellGroupData[{

Cell["Exercises - Chapter III", "Subsection",ExpressionUUID->"7f257841-0f7e-42dc-a611-7a5272eb8b14"],

Cell[CellGroupData[{

Cell["Exercise 3.4", "Subsubsection",ExpressionUUID->"fd925d75-9f5b-45ca-92c7-b11c9a9e5e57"],

Cell["\<\
Express each Pi of Example 2.4 as m P1 + n P3. Answer: P2 = -2P1 + P3, P4 = \
P1 - P3, P5 = -2P1, P6 = -P1 + 2P3, P7 = 3P1 - P3, P8 = -4P1 + 3P3.\
\>", "Text",ExpressionUUID->"b57a4f9c-7ac4-42e9-aba1-5f80fc881008"],

