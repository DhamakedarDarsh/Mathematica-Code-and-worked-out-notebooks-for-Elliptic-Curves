Cell[CellGroupData[{

Cell["Chapter V - Elliptic Curves over Finite Fields", "Section",ExpressionUUID->"2f7772c9-ecd9-44c6-a8ee-591bf89b83d3"],

Cell[CellGroupData[{

Cell["Examples (4.4) and (4.5)", "Subsection",ExpressionUUID->"519b13b4-b1b6-4dfb-9bb4-0a94b4f51959"],

Cell["\<\
For p >= 5, y^2 = x^3 + 1 is supersingular (i.e. #E(F_p) = p + 1) exactly \
when p = 2 mod 3, and y^2 = x^3 + x is supersingular exactly when p = 3 mod 4.\
\>", "Text",ExpressionUUID->"db0d23b4-5aba-479a-9efe-98e9edf0984e"],

Cell[CellGroupData[{

Cell["\<\
Table[{p, Mod[p, 3], ECPSEAPointCount[{0, 1}, p] == p + 1}, {p, \
Prime[Range[3, 20]]}] // TableForm\
\>", "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"d5445bcd-2f73-4fc1-aeb1-1d20444acee2"],

