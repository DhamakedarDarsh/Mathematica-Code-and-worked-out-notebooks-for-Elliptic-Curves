Cell[CellGroupData[{

Cell["\<\
Rational Points on Elliptic Curves, 2nd Edition, Silverman and Tate\
\>", "Title",ExpressionUUID->"ecf5e355-3f93-4c8b-a5a0-52b2d8bb098e"],

Cell[CellGroupData[{

Cell["Introduction", "Section",ExpressionUUID->"9457b028-2adf-437a-819a-cc28402deb66"],

Cell[CellGroupData[{

Cell["Bachet's duplication formula", "Subsection",ExpressionUUID->"c7004fef-9ce7-4cc9-bbb6-2a377d601931"],

Cell["\<\
Starting from the solution (3, 5) of y^2 = x^3 - 2, Bachet's duplication \
formula produces new rational solutions. The first one is (129/100, \
-383/1000).\
\>", "Text",ExpressionUUID->"fb9cd061-d4f3-409b-871b-0ab4a983f6aa"],

Cell[CellGroupData[{

Cell["ECPBachetDuplication[x, {0, -2}]", "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"58e3d6dc-34f2-4d8f-8f1b-a6363d3dd0cf"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"16", " ", "x"}], "+", 
   SuperscriptBox["x", "4"]}], 
  RowBox[{"4", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "2"}], "+", 
     SuperscriptBox["x", "3"]}], ")"}]}]]], "Output",
 CellChangeTimes->{4.003476548706674*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"ce861608-c7d5-45a1-bc8d-0cfd205bb20d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ECPBachetDuplication[{3, 5}, {0, -2}]", "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"25487d82-3319-4bdd-813b-2d249e32003e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["129", "100"], ",", 
   RowBox[{"-", 
    FractionBox["383", "1000"]}]}], "}"}]], "Output",
 CellChangeTimes->{4.0034765488118944`*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"f0ed2457-74f7-4ffa-a371-c878bd7fa3d4"]
}, Open  ]],

