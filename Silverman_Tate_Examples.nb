Cell[CellGroupData[{

Cell["Exercise 4.7", "Subsubsection",ExpressionUUID->"e6e5bdd3-9b03-4784-8dac-d330726247ae"],

Cell["\<\
If b = 11 and c = 4 mod 15, then y^2 = x^3 + bx + c has no rational torsion \
points except O: it has 7 points mod 3 and 9 points mod 5.\
\>", "Text",ExpressionUUID->"73cdbd0e-0bb6-41d9-bade-fff69eb761ab"],

