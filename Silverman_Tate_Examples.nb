Cell[CellGroupData[{

Cell["Exercise 4.29", "Subsubsection",ExpressionUUID->"85a58476-4098-45cc-a46d-a8184e927df4"],

Cell["\<\
Solve the discrete logarithm problems (a) y^2 = x^3 + x^2 + x + 3 over F_103, \
P = (7, 14), Q = (8, 22); (b) y^2 = x^3 - 2x^2 + 5x + 6 over F_149, P = (11, \
16), Q = (110, 46); (c) y^2 = x^3 + x^2 + x + 2 over F_10037, P = (8, 7358), \
Q = (2057, 5437).\
\>", "Text",ExpressionUUID->"ffa3909d-c093-4df8-b401-1629f7b25433"],

