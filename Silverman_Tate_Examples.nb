Cell[CellGroupData[{

Cell["Exercises - Chapter 5", "Subsection",ExpressionUUID->"9a9f2ee2-d9cd-4de6-aa77-3f6784b0b4c0"],

Cell[CellGroupData[{

Cell["Exercise 5.12 - elliptic divisibility sequences", "Subsubsection",ExpressionUUID->"6d5058ed-a207-4b96-9115-5c382fa441b0"],

Cell["\<\
On y^2 = x^3 - 5x with P = (-1, 2), write x(nP) = a_n/d_n^2. If m divides n \
then d_m divides d_n.\
\>", "Text",ExpressionUUID->"c1d9f6e4-4a6a-40bc-bd6b-36734fc46b51"],

Cell[CellGroupData[{

Cell["\<\
Table[Sqrt[Denominator[ECPMultiply[n, {-1, 2}, {-5, 0}][[1]]]], {n, 1, 10}]\
\>", "Input",
 CellLabel->
  "In[121]:=",ExpressionUUID->"6c932065-49ee-4a8c-bca2-ee74a0ca07ae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "2", ",", "13", ",", "12", ",", "2005", ",", "51194", ",", 
   "4398073", ",", "100151016", ",", "104958878089", ",", "33521004282890"}], 
  "}"}]], "Output",
 CellChangeTimes->{4.0034773508146124`*^9},
 CellLabel->
  "Out[121]=",ExpressionUUID->"076bcaf3-1736-4115-ba6f-468beade586c"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Chapter 6 - Complex Multiplication", "Section",ExpressionUUID->"222e4c91-83ca-4ea7-a9f1-83e281cc8d24"],

Cell[CellGroupData[{

Cell["Example 6.6 - points of order 3 on y^2 = x^3 + x", "Subsection",ExpressionUUID->"4052d086-e0a8-4109-8551-3046e2c08847"],

Cell["\<\
The x-coordinates of the points of order 3 are the roots of 3x^4 + 6x^2 - 1. \
One root is x = Sqrt[(2 Sqrt[3] - 3)/3]. A point P has order 3 exactly when \
2P = -P, i.e. when x(2P) = x(P). The duplication formula gives x(2P) from \
x(P), so the difference below must simplify to 0. (ECPFindPointOrder works \
with exact rational points and cannot decide this for coordinates with nested \
radicals.)\
\>", "Text",ExpressionUUID->"1bcf07ac-9925-426f-8987-7dd71a40cd94"],

Cell["x3 = Sqrt[(2 Sqrt[3] - 3)/3];", "Input",
 CellLabel->
  "In[122]:=",ExpressionUUID->"5b53af2a-b679-4ae2-8d14-a6a322fa40ce"],

Cell[CellGroupData[{

Cell["FullSimplify[ECPBachetDuplication[x3, {1, 0}] - x3]", "Input",
 CellLabel->
  "In[123]:=",ExpressionUUID->"635d1278-0393-4da4-82bd-d69d8f2978a8"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{4.0034773511561775`*^9},
 CellLabel->
  "Out[123]=",ExpressionUUID->"8c323ae1-7ac1-419d-a8e4-7c57a7faba52"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Examples 6.9 and 6.10 - the 2-torsion of y^2 = x^3 - 2", "Subsection",ExpressionUUID->"9f287b71-2aa8-4f41-8517-d574fc850903"],

Cell["\<\
The points P1 = (b, 0), P2 = (z b, 0), P3 = (z^2 b, 0), with b the real cube \
root of 2 and z a cube root of 1, satisfy P1 + P2 = P3.\
\>", "Text",ExpressionUUID->"6805ccbd-f063-4e32-bd86-c4be111dcec3"],

Cell[CellGroupData[{

Cell["\<\
FullSimplify[ECPAdd[{2^(1/3), 0}, {Exp[2 Pi I/3] 2^(1/3), 0}, {0, -2}]]\
\>", "Input",
 CellLabel->
  "In[124]:=",ExpressionUUID->"d03b6a98-362e-4717-a6eb-358f280178eb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "2"}], ")"}], 
     RowBox[{"1", "/", "3"}]]}], ",", "0"}], "}"}]], "Output",
 CellChangeTimes->{4.003477351765707*^9},
 CellLabel->
  "Out[124]=",ExpressionUUID->"96fcb74e-6a64-4944-b0f3-0e7655fae1f6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FullSimplify[-(-2)^(1/3) == Exp[4 Pi I/3] 2^(1/3)]", "Input",
 CellLabel->
  "In[125]:=",ExpressionUUID->"b31cd858-006a-4c3f-9e8a-0f9c3bdf3972"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{4.0034773520103364`*^9},
 CellLabel->
  "Out[125]=",ExpressionUUID->"70ca52db-e2ef-4965-a8ff-c086a937c503"]
}, Open  ]],

Cell["\<\
Mathematica writes the sum as (-(-2)^(1/3), 0). Since (-2)^(1/3) = 2^(1/3) \
Exp[Pi I/3], this is 2^(1/3) Exp[4 Pi I/3] = z^2 b, i.e. P3, as the second \
cell confirms.\
\>", "Text",ExpressionUUID->"6e78178b-6128-46b6-846b-a4f75b6ffafa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Section 6.4 - the Weil pairing on a supersingular curve", "Subsection",ExpressionUUID->"8f208a2a-ff2a-41ac-aac1-923c68f2a6b2"],

Cell["\<\
y^2 = x^3 + x is supersingular at p = 11, so E(F_121) = Z/12 x Z/12 contains \
all of E[3]. The Weil pairing of a basis is a primitive cube root of unity.\
\>", "Text",ExpressionUUID->"f5106fb4-5df4-414f-8752-0e2008d9ab35"],

Cell[CellGroupData[{

Cell["ECPGroupFp[{1, 0}, {11, 2}]", "Input",
 CellLabel->
  "In[126]:=",ExpressionUUID->"37ddba46-6460-47f9-9d5b-6b7baf8f25a6"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Field\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"11", ",", "2"}], "}"}]}], ",", 
   RowBox[{"\<\"Curve\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "1", ",", "0"}], "}"}]}], ",", 
   RowBox[{"\<\"Order\"\>", "\[Rule]", "144"}], ",", 
   RowBox[{"\<\"Invariants\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"12", ",", "12"}], "}"}]}], ",", 
   RowBox[{"\<\"Structure\"\>", "\[Rule]", "\<\"Z/12 x Z/12\"\>"}], ",", 
   RowBox[{"\<\"Generators\"\>", "\[Rule]", 
