Cell[CellGroupData[{

Cell["Section 2.5 - y^2 = x^3 - x^2 + x", "Subsection",ExpressionUUID->"6ebd69d9-8002-45af-bc61-f7763ade86ad"],

Cell["\<\
The Nagell-Lutz theorem shows that the torsion subgroup is cyclic of order 4, \
generated by (1, 1).\
