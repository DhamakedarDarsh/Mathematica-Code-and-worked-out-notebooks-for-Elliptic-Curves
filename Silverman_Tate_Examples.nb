Cell[CellGroupData[{

Cell["Exercise 6.25 - the L-series of y^2 = x^3 + x^2 + x + 1", "Subsection",ExpressionUUID->"5a646ad1-fc44-4fcd-92cc-b476f048e335"],

Cell["\<\
The book's table of a_p = p + 1 - #E(F_p): 3: -2, 5: -2, 7: -4, 11: 2, 13: \
-2, 17: -2, 19: -2, 23: 4, 29: 6. The only bad prime is 2.\
\>", "Text",ExpressionUUID->"ebcb0155-f102-4ffb-9df8-8bda34f0f76f"],

Cell[CellGroupData[{

Cell["\<\
Table[{p, p + 1 - ECPSEAPointCount[{0, 1, 0, 1, 1}, p]}, {p, {3, 5, 7, 11, \
13, 17, 19, 23, 29}}] // TableForm\
\>", "Input",
 CellLabel->
