Cell[CellGroupData[{

Cell["Section 4.2 - Gauss's theorem", "Subsection",ExpressionUUID->"f5e6d1c5-50d5-4064-8c46-e8636461c760"],

Cell["\<\
The Fermat cubic x^3 + y^3 + z^3 = 0 is isomorphic to y^2 = x^3 - 432, so its \
number of points over F_p is #E(F_p). The book's table gives M_p = 9, 9, 27, \
36, 3924 for p = 7, 13, 19, 31, 4027. For p = 2 mod 3, M_p = p + 1.\
\>", "Text",ExpressionUUID->"97d96771-3f36-442d-8c0d-0e6184bb13fd"],

Cell[CellGroupData[{

Cell["\<\
Table[{p, ECPSEAPointCount[{0, -432}, p]}, {p, {7, 13, 19, 31, 4027}}] // \
TableForm\
\>", "Input",
 CellLabel->"In[78]:=",ExpressionUUID->"7a495a4d-ed5e-48ba-a169-7f6efcf8ef93"],

Cell[BoxData[
 TagBox[GridBox[{
    {"7", "9"},
    {"13", "9"},
    {"19", "27"},
    {"31", "36"},
    {"4027", "3924"}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
   GridBoxSpacings->{"Columns" -> {
       Offset[0.27999999999999997`], {
        Offset[2.0999999999999996`]}, 
       Offset[0.27999999999999997`]}, "Rows" -> {
       Offset[0.2], {
        Offset[0.4]}, 
       Offset[0.2]}}],
