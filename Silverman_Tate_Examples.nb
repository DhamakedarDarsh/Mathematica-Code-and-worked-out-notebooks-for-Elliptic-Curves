Cell[CellGroupData[{

Cell["Chapter 5 - Integer Points on Cubic Curves", "Section",ExpressionUUID->"90944e0c-ec65-4191-a01f-92b9c64d93fc"],

Cell[CellGroupData[{

Cell["Proposition 5.3 - x^3 + y^3 = 9", "Subsection",ExpressionUUID->"bca6e16a-3c7a-43e6-884f-ca47d026cea9"],

Cell["\<\
The curve u^3 + v^3 = 9 corresponds to y^2 = x^3 - 48 with the point Q = (4, \
4). The torsion is trivial, so Q has infinite order and there are infinitely \
many rational points.\
\>", "Text",ExpressionUUID->"8a6985e9-6a1f-4537-84ac-60bcaf567a43"],

Cell[CellGroupData[{

Cell["ECPMultiply[2, {4, 4}, {0, -48}]", "Input",
 CellLabel->
  "In[116]:=",ExpressionUUID->"9a56d414-af91-4d84-9ec1-d2fd66cacb56"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"28", ",", 
   RowBox[{"-", "148"}]}], "}"}]], "Output",
 CellChangeTimes->{4.003477330081026*^9},
 CellLabel->
  "Out[116]=",ExpressionUUID->"d916ba90-96ec-4d97-9067-fd43fd130bee"]
}, Open  ]],

