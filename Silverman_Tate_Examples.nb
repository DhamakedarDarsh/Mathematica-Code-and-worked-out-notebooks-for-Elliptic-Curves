Cell[CellGroupData[{

Cell["Exercise 4.6", "Subsubsection",ExpressionUUID->"4e984882-fc4d-48cf-9ef5-6a2b424643d5"],

Cell["\<\
The curve y^2 = x^3 - 4x^2 + 16 has conductor 11; its minimal model is y^2 + \
y = x^3 - x^2. The numbers a_p = p + 1 - #E(F_p) are the coefficients of q^p \
in q Product[(1 - q^n)^2 (1 - q^(11 n))^2, n >= 1], namely -2, -1, 1, -2, 4, \
-2, 0, -1 for p = 2, 3, 5, 7, 13, 17, 19, 23.\
\>", "Text",ExpressionUUID->"5e04151d-cf93-4d2e-b992-0e95cda95cd0"],

Cell[CellGroupData[{

Cell["ECPMinimalModel[{0, -4, 0, 0, 16}]", "Input",
 CellLabel->"In[93]:=",ExpressionUUID->"d65f0677-bc62-4cbe-b895-281bd76ac7d5"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"MinimalCoefficients\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}], ",", "1", ",", "0", ",", "0"}], "}"}]}], ",", 
   RowBox[{"\<\"Equation\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"y", "+", 
      SuperscriptBox["y", "2"]}], "\[Equal]", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["x", "2"]}], "+", 
      SuperscriptBox["x", "3"]}]}]}], ",", 
   RowBox[{"\<\"Transformation\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "0", ",", "0", ",", "4"}], "}"}]}], ",", 
   RowBox[{"\<\"Discriminant\"\>", "\[Rule]", 
    RowBox[{"-", "11"}]}], ",", 
   RowBox[{"\<\"OldDiscriminant\"\>", "\[Rule]", 
    RowBox[{"-", "45056"}]}], ",", 
   RowBox[{"\<\"IsMinimal\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0034773198489666`*^9},
 CellLabel->"Out[93]=",ExpressionUUID->"427e0014-abfa-4018-aa58-029a75444443"]
}, Open  ]],

