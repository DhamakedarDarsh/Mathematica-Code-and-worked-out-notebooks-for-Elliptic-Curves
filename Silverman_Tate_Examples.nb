 CellLabel->"Out[49]=",ExpressionUUID->"c1137449-21ee-4452-81a1-f382586a9102"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Chapter 3 - The Group of Rational Points", "Section",ExpressionUUID->"84bb75c9-7648-47fa-865a-cba2db941d62"],

Cell[CellGroupData[{

Cell["Section 3.1 - heights on y^2 = x^3 - 5x", "Subsection",ExpressionUUID->"3195f970-c7c8-47b0-a8c2-e4902ccb5fe7"],

Cell["\<\
The naive height of 2^k P grows roughly by a factor 4 at each doubling; the \
limit of h(2^k P)/4^k is the canonical height. Here P = (-1, 2).\
\>", "Text",ExpressionUUID->"c1afbd4d-b882-4749-9007-5f5a600cc86b"],

Cell[CellGroupData[{

Cell["\<\
Table[N[ECPNaiveHeight[ECPMultiply[2^k, {-1, 2}, {-5, 0}]]], {k, 0, 4}]\
\>", "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"ae0d8043-f5ff-4580-ad73-e606df4d3be0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
