Cell["\<\
Answer: Q6 = (43, 282), Q7 = (52, 375). The integral points have x = -2, -1, \
2, 4, 8, 43, 52, 5234 (16 points with the signs of y). The rank is 2.\
\>", "Text",ExpressionUUID->"5110ea23-4827-4c19-9cd2-01f6ef42414c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Exercise 1.20", "Subsubsection",ExpressionUUID->"05126265-eba5-4fd8-a5ad-0e0907b3f64c"],

Cell["\<\
Let P = (3, 8) on y^2 = x^3 - 43x + 166. Compute P, 2P, 4P, 8P and conclude \
that P has finite order.\
\>", "Text",ExpressionUUID->"a6557a3f-d020-4667-9bbb-a42cf93468cb"],

Cell[CellGroupData[{

Cell["Table[ECPMultiply[n, {3, 8}, {-43, 166}], {n, {1, 2, 4, 8}}]", "Input",
