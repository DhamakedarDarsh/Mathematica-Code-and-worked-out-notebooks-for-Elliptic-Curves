Cell[CellGroupData[{

Cell["Chapter 1 - Geometry and Arithmetic", "Section",ExpressionUUID->"5aa3b2ea-967d-48c9-b18b-24c56ea120b4"],

Cell[CellGroupData[{

Cell["Section 1.3 - Weierstrass normal form of u^3 + v^3 = 9", "Subsection",ExpressionUUID->"eea2e577-5328-4d70-af62-73c2c759fd87"],

Cell["\<\
The cubic u^3 + v^3 = 9 has the rational point [1, -1, 0]. ECPack returns Y^2 \
= X^3 - 2187/4. Since 2187/4 = 48 (3/2)^6, this is isomorphic over Q to the \
book's y^2 = x^3 - 48 used in Section 5.2 (both have j = 0).\
\>", "Text",ExpressionUUID->"c21f7f28-21ee-49b8-9703-988051586a6d"],

Cell[CellGroupData[{

Cell["\<\
ECPCubicToWeierstrass[{1, -1, 0}, x^3 + y^3 - 9 z^3, \"Form\" -> \"Short\"]\
\>", "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"d513a788-26f5-40c4-bd1c-92eb0c788b08"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["Y", "2"], "\[Equal]", 
  RowBox[{
   RowBox[{"-", 
    FractionBox["2187", "4"]}], "+", 
   SuperscriptBox["X", "3"]}]}]], "Output",
 CellChangeTimes->{4.003476560258582*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"0062b202-4e1c-48f3-b94f-f0975b6e49f2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Appendix B - the cubic X^3 + 2Y^3 + 4Z^3 = 7XYZ", "Subsection",ExpressionUUID->"1341a603-5325-46ac-9d4f-80085c0a1f6a"],

Cell["\<\
Using the rational point [1, 1, 1], the book transforms this cubic into y^2 = \
x^3 - 2975x^2 - 70000x + 9000000. ECPack may choose a different model; the \
j-invariants must agree.\
\>", "Text",ExpressionUUID->"69364388-17a3-4757-abed-3cd622d11064"],

Cell[CellGroupData[{

Cell["\<\
wB = ECPCubicToWeierstrass[{1, 1, 1}, x^3 + 2 y^3 + 4 z^3 - 7 x y z]\
\>", "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"c214d825-f57a-462f-8ac6-aed388c1d422"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"280", " ", 
    SuperscriptBox["x", "2"]}], "961"], "-", 
  SuperscriptBox["x", "3"], "+", 
  FractionBox[
   RowBox[{"162", " ", "y"}], "29791"], "-", 
  FractionBox[
   RowBox[{"7", " ", "x", " ", "y"}], "31"], "+", 
  SuperscriptBox["y", "2"]}]], "Output",
 CellChangeTimes->{4.003476560304298*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"6f138c5c-f9a1-4bf0-943e-dc9d64a025e2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ECPJInvariant[ECPExtractCoefficients[wB]]", "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"43c3b636-c6dc-44d0-a62e-f143fa7d573f"],

Cell[BoxData[
 FractionBox["3046733141473", "16387064"]], "Output",
