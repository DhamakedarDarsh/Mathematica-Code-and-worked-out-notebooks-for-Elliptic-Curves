     RowBox[{"-", "5"}], ",", 
     RowBox[{"-", "16"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"11", ",", "32"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "8"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.0034767703188004`*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"6dab354c-bebb-4561-ac3a-f8a7bf3f15c4"]
}, Open  ]],

