Cell[CellGroupData[{

Cell["Exercises - Chapter 1", "Subsection",ExpressionUUID->"28549022-aad8-48f6-9429-91dc7ffe3646"],

Cell[CellGroupData[{

Cell["Exercise 1.18", "Subsubsection",ExpressionUUID->"3780a7e1-8f9c-4403-953b-70a157e13b77"],

Cell["\<\
On y^2 = x^3 + 17 let Q1 = (-2, 3), Q2 = (-1, 4), Q3 = (2, 5), Q4 = (4, 9), \
Q5 = (8, 23). (a) Show Q2 = -2Q1 + Q3, Q4 = Q1 - Q3, Q5 = -2Q1. (b) Compute \
Q6 = -Q1 + 2Q3 and Q7 = 3Q1 - Q3. (c) Find the integral points.\
\>", "Text",ExpressionUUID->"2ec93be0-a072-4b7a-a61f-1f69fa431f52"],

