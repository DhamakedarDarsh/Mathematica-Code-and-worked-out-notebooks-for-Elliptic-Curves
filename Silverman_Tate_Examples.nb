Cell[CellGroupData[{

Cell["Section 6.6 - a Frey curve", "Subsection",ExpressionUUID->"d0e1f0ff-bdd9-4204-84b0-c6a87007a71d"],

Cell["\<\
For A + B = C the curve y^2 = x(x - A)(x + B) has discriminant 16(ABC)^2. \
With 1 + 8 = 9 we get y^2 = x(x - 1)(x + 8) = x^3 + 7x^2 - 8x; every odd bad \
prime has multiplicative reduction.\
\>", "Text",ExpressionUUID->"1e95643a-f7dc-46f0-901d-3673b4531b4b"],

Cell[CellGroupData[{

Cell["\<\
ECPWeierstrassDiscriminant[{0, 7, 0, -8, 0}] // FactorInteger\
\>", "Input",
 CellLabel->
