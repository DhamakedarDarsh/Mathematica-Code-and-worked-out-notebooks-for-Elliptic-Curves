Cell[CellGroupData[{

Cell["Example 4.10", "Subsubsection",ExpressionUUID->"de3ac894-23db-48f5-bedc-a74e43186b5a"],

Cell["\<\
On y^2 = x^3 + x^2 + x + 1 over F_97, find m with m(7, 20) = (17, 46).\
