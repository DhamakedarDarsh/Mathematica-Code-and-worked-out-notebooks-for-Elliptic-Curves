       RowBox[{"\<\"Points\"\>", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\[Infinity]", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "}"}]}]}], 
      "\[RightAssociation]"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.0034773201174717`*^9},
 CellLabel->
  "Out[101]=",ExpressionUUID->"9adcec7e-692d-4c96-962b-23b949893100"]
}, Open  ]],

Cell["\<\
Answer: Z/4 for b = 4; Z/2 x Z/2 for b = -1, -4; Z/2 for b = 2. Z/6 for c = \
1; Z/3 for c = 4, -432; Z/2 for c = 8; trivial otherwise.\
\>", "Text",ExpressionUUID->"9a239bcb-03df-4383-a144-4bb1156341f7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Section 4.4 - Lenstra's factorization", "Subsection",ExpressionUUID->"fdbcfd5b-1d11-45b4-8dab-c67e66cd98d3"],

Cell["\<\
The book factors n = 1715761513 using the curve y^2 = x^3 + 5x - 9 (b = 5) \
and finds 26927. It works because the group order mod 26927 has only small \
prime factors.\
\>", "Text",ExpressionUUID->"3ea54e35-0220-4fde-9340-efac11d1e78b"],

