Cell["\<\
Answer: (a) trivial, (b) Z/2, (c) Z/3, (d) Z/4, (e) Z/5, (f) Z/6, (g) Z/7, \
(h) Z/8, (i) Z/9, (j) Z/10, (k) Z/12, (l) Z/2 x Z/2, (m) Z/2 x Z/4, (n) Z/2 x \
Z/6, (o) Z/2 x Z/8.\
\>", "Text",ExpressionUUID->"e5d90343-c9d1-4a14-896b-6f6352016587"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Exercise 2.13", "Subsubsection",ExpressionUUID->"7ad67229-3b67-4d92-b093-f24c0ab3b7b1"],

Cell["\<\
On y^2 = x^3 - (2t - 1)x^2 + t^2 x the point (t, t) has order 4. Check it for \
t = 2 and t = 3.\
\>", "Text",ExpressionUUID->"e313ea23-90c0-48f9-8af8-8569bef68891"],

Cell[CellGroupData[{

Cell["ECPFindPointOrder[{2, 2}, {0, -3, 0, 4, 0}]", "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"eb1a0b8c-33d0-49a9-b567-889dae241ccf"],

Cell[BoxData["4"], "Output",
 CellChangeTimes->{4.003476775188963*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"8f96acf1-8a44-4d93-973b-f35177f00a62"]
}, Open  ]],

