Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"Consider", " ", "the", " ", "equation", " ", 
     FormBox[
      SuperscriptBox["v", "2"],
      TraditionalForm]}], " ", "=", " ", 
    RowBox[{
     FormBox[
      SuperscriptBox["u", "4"],
      TraditionalForm], " ", "+", " ", 
     RowBox[{"1.", " ", "So", " ", "here"}]}]}], ",", " ", 
   RowBox[{"a", "=", "1"}], ",", " ", 
   RowBox[{"b", "=", 
    RowBox[{"c", "=", 
     RowBox[{"d", "=", "0"}]}]}], ",", " ", 
   RowBox[{
    RowBox[{"and", " ", "e"}], "=", 
    RowBox[{
    "1.", " ", "Using", " ", "the", " ", "Quartic", " ", "to", " ", "short", " ",
      "Weierstrass", " ", "transformation"}]}], ",", " ", 
   RowBox[{
    RowBox[{
    "we", " ", "obtain", " ", "the", " ", "elliptic", " ", "curve", " ", "E", 
     " ", "given", " ", "by", " ", 
     FormBox[
      SuperscriptBox["y", "2"],
      TraditionalForm]}], " ", "=", " ", 
    RowBox[{
     FormBox[
      SuperscriptBox["x", "3"],
      TraditionalForm], " ", "\[Minus]", " ", 
     RowBox[{"4", 
      RowBox[{"x", "."}]}]}]}]}],
  FontFamily->"Source Sans Pro"]], "Text",
 CellChangeTimes->{{3.999746137883525*^9, 3.999746140309062*^9}, 
