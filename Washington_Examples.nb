Cell[CellGroupData[{

Cell["Example (4.1)", "Subsection",
 CellChangeTimes->{
  3.9997557123984423`*^9, {3.999756509146699*^9, 
   3.9997565104994926`*^9}},ExpressionUUID->"9550147f-c368-4cab-8415-\
d1df6d8e86d3"],

Cell[TextData[{
 "Let E be the curve ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "3a17be8b-eb8a-4d92-b825-a0e0b994f5cd"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "2312b9cb-05f1-457d-87db-f51639386bd8"],
 " + x + 1 over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "5"], TraditionalForm]],ExpressionUUID->
  "556bebb6-bba3-474d-b874-368da5854d09"],
 " . To count points on E, we make a\nlist of the possible values of x, then \
of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "22992cce-7fb4-4296-8f78-6d200d8fa71c"],
 " + x + 1 (mod 5), then of the square\nroots y of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "db21ec3e-d70d-4e86-b7b0-435795b812d3"],
 " + x + 1 (mod 5). This yields the points on E."
}], "Text",
 CellChangeTimes->{{3.999755977811721*^9, 
  3.999756001897522*^9}},ExpressionUUID->"ab625ceb-efd6-4568-9e29-\
10953e7843a3"],

