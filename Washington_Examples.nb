  3.9997528504197807`*^9}},ExpressionUUID->"177696fd-feab-4b4f-9d24-\
cb9528123916"],

Cell[TextData[{
 "According to the Chinese Remainder Theorem, we can write ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "(", 
    SubscriptBox["Z", "35"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "88971024-a667-4bc3-979d-7b10d71068b9"],
 ") = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "(", 
    SubscriptBox["Z", "5"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7a1ed500-1edb-457f-ba87-c49c5ec748e2"],
 ") \[CirclePlus] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "(", 
    SubscriptBox["Z", "7"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "39d51819-4334-4ad7-bfec-af441d91735d"],
 ") and then work mod 5 and mod 7 separately."
}], "Text",
 CellChangeTimes->{{4.002674798211403*^9, 
  4.0026748498688517`*^9}},ExpressionUUID->"c057e3cb-dd27-4e32-8a0f-\
e69c28abadfc"],

