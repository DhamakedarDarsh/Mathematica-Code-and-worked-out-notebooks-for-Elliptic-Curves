Cell[TextData[{
 "On the curve ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "f3cd6055-3ef6-408c-b9be-7ab072b979c3"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"x", 
     RowBox[{"(", 
      RowBox[{"x", " ", "+", " ", "1"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "x"}], " ", "+", " ", "1"}], ")"}]}], "6"], 
   TraditionalForm]],ExpressionUUID->"d77edb0e-e2bc-4f2e-a03e-eac982b4be81"],
 ", we have (0,0) and (1,1)."
}], "Text",
 CellChangeTimes->{{3.999746137883525*^9, 3.999746140309062*^9}, 
   3.999747944841783*^9, 
