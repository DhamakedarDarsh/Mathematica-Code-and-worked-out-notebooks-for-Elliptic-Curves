Cell[TextData[{
 "Show that the cubic equation ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "96572b6b-9c14-44b0-9ed7-ad5abb7df443"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "49ab1009-909e-44fc-95f2-ff4ee80a2f59"],
 " = d can be transformed to the\nelliptic curve ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["y", "1"], "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ab6fd8c9-1c0d-4e40-a78a-70a5818da6d6"],
 " = ",
 Cell[BoxData[
  FormBox[
