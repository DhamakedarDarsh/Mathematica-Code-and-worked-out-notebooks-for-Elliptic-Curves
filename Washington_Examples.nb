Cell[TextData[{
 "Let E be the elliptic curve ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "29ce6699-b4ea-4199-80bd-e1449a83d962"],
 "= ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "aa044715-d830-41a6-ada8-06fb3a094ad4"],
 " \[Minus] 10x + 21 over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "557"], TraditionalForm]],ExpressionUUID->
  "87cf75ad-69f8-45d8-9e15-a4ab5a1c217a"],
 " , as in Example 4.7.\nLet P = (2, 3). Show that Q = 558P = (418, 33)."
}], "Text",
 CellChangeTimes->{{3.9997583144534483`*^9, 3.999758333503159*^9}, 
