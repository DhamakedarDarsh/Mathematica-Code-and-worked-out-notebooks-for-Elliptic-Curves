Cell[CellGroupData[{

Cell["Example (4.8)", "Subsection",
 CellChangeTimes->{{3.999757762841365*^9, 
  3.99975776971598*^9}},ExpressionUUID->"c9cd2a0a-d785-4409-a356-\
3c46a153416b"],

Cell[TextData[{
 "Let E be the elliptic curve ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "096a0436-069a-465f-9dea-3f6ddafa7b92"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a64454a2-7e7b-4d23-97c7-e039fdf6c337"],
 " + 7x + 12 over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "103"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9740d2fb-dd0b-4ebb-9031-4e3dcb0764b0"],
 " . The point (\[Minus]1, 2)\nhas order 13 and the point (19, 0) has order \
2. Therefore the order ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "103"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e8cbb128-530f-4c2d-89aa-39b9a38288c2"],
 " of\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "(", 
    SubscriptBox["F", "103"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3a140a14-4dcc-43a0-a8db-19405ab273fe"],
 ") is a multiple of 26. Hasse\[CloseCurlyQuote]s theorem implies that 84 \
\[LessEqual] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "103"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5fec521c-85b5-46ab-8add-233a11ce095e"],
 " \[LessEqual] 124.\nThe only multiple of 26 in that range is 104, so ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "103"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "aa070605-6310-4c04-baaf-16735b87e397"],
 " = 104."
}], "Text",
 CellChangeTimes->{{3.999757782530846*^9, 
  3.9997578261582603`*^9}},ExpressionUUID->"1b67e047-a6af-4d05-872f-\
6b1f21f5c413"],

