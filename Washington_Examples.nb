Cell[CellGroupData[{

Cell["Exercise (3.1)", "Subsubsection",
 CellChangeTimes->{{3.999755565145134*^9, 3.9997555669772*^9}, {
  3.999755598619588*^9, 
  3.999755600394112*^9}},ExpressionUUID->"1d7a8fc3-bbc1-4131-8503-\
1e1a806edfa2"],

Cell[TextData[{
 "Let E be the elliptic curve ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "e3578dcb-6692-4630-abc9-8d6193a0a38f"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "c99fea40-1ad8-43c8-800c-42496019372a"],
 " + 1 mod 5. Show that the 3-torsion points in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "(", 
    SubscriptBox["F", "5"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c566e17a-1502-4f8d-988e-c15d768031ed"],
 ") are {\[Infinity], (0, 1), (0, \[Minus]1)}."
}], "Text",
 CellChangeTimes->{{3.999755604047246*^9, 3.999755613244814*^9}, {
  4.002677396025094*^9, 
  4.002677411409368*^9}},ExpressionUUID->"32efdf0a-dbb5-48cb-b457-\
a11614603235"],

