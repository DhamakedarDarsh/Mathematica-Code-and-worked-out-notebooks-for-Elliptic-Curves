Cell[TextData[{
 "According to the Chinese Remainder Theorem, we can write ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "(", 
    SubscriptBox["Z", "35"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ee18182d-69ae-4cd2-80e4-182f057bee4f"],
 ") = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "(", 
    SubscriptBox["Z", "5"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3c266e4e-af84-4d27-8c2d-94e987ecdba4"],
 ") \[CirclePlus] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"E", "(", 
    SubscriptBox["Z", "7"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "91b7b5c7-817d-46b6-8e47-70f959dd6a7d"],
 ") and then work mod 5 and mod 7 separately."
}], "Text",
 CellChangeTimes->{
  4.00269824932631*^9},ExpressionUUID->"d8b05c3c-5bdd-4258-be61-6990ba2137ad"],

