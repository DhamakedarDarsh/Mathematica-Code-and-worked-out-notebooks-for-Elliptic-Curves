Cell[TextData[{
 "Show that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"#E", 
    RowBox[{"(", 
     SubscriptBox["F", 
      SuperscriptBox["2", "n"]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ad43ebe2-8ce6-46b2-9e28-83caa40ec383"],
 ") = { ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["2", "n"], "+", 
     RowBox[{"1", "   ", "if", " ", "n", " ", "is", " ", "odd"}]}], ",", " ", 
    
    RowBox[{
     RowBox[{"and", " ", 
      SuperscriptBox["2", "n"]}], "+", "1", "-", 
     RowBox[{"2", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "2"}], ")"}], 
       FractionBox["n", "2"]], "  ", "if", " ", "n", " ", "is", " ", 
      RowBox[{"even", "."}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "154e5274-c1d7-4b87-8bdf-b150451aef78"]
}], "Text",
 CellChangeTimes->{{4.002695447475514*^9, 4.0026954679954777`*^9}, {
  4.002695508468213*^9, 
  4.002695590932818*^9}},ExpressionUUID->"109d483f-e9e7-46d2-b93f-\
e724243def54"],

