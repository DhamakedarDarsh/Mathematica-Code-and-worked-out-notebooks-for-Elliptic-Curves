    SubscriptBox["x", "1"], "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cfb92ab4-0d61-4d31-a358-d844c0a67560"],
 " \[Minus] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"432", 
    SuperscriptBox["d", "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fd7a23fc-1666-409c-bb6f-0f1d02ab4fcc"],
 ". Let d = 1, a projective point on this curve can be [1:0:1]."
}], "Text",
