Cell[CellGroupData[{

Cell["Example (4.7)", "Subsection",
 CellChangeTimes->{{3.999757653490135*^9, 
  3.99975765824238*^9}},ExpressionUUID->"3c43ea8f-e0d1-433e-aa55-\
fcce5db4a645"],

Cell[TextData[{
 "Let E be the elliptic curve ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "105fee60-cfbe-4681-a376-c37e77a24b64"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "25d9dcaf-0baa-4716-87c3-a3fe299bcefc"],
 " \[Minus] 10x + 21 over ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", "557"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "587dac89-0f9a-4b94-b6b9-d2f422df0c6c"],
 " . The point (2, 3) can\nbe shown to have order 189. \
Hasse\[CloseCurlyQuote]s theorem implies that 511 \[LessEqual] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "557"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2018a1b1-b1e4-40a7-9d20-cd008d6bb777"],
 " \[LessEqual] 605.\nThe only multiple of 189 in this range is 3 \
\[CenterDot] 189 = 567. Therefore ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "557"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "37ee3ea8-a778-4429-a93d-65952a6a381c"],
 " = 567."
}], "Text",
 CellChangeTimes->{{3.9997576621948013`*^9, 
  3.999757687693544*^9}},ExpressionUUID->"14f424c5-db69-4d55-adae-\
a777491855df"],

