Cell[TextData[{
 "Both ",
 Cell[BoxData[
  RowBox[{
   FormBox[
    SuperscriptBox["y", "2"],
    TraditionalForm], " ", "=", " ", 
   RowBox[{
    FormBox[
     SuperscriptBox["x", "3"],
     TraditionalForm], " ", "\[Minus]", " ", 
    RowBox[{"4", "x"}]}]}]],
  CellChangeTimes->{{3.999746137883525*^9, 3.999746140309062*^9}, 
    3.999747944841783*^9, {3.999748096791851*^9, 3.999748143140012*^9}, {
    3.9997483577714043`*^9, 3.999748384378436*^9}, {3.9997484503152647`*^9, 
    3.999748461955057*^9}, {4.002603596470834*^9, 4.002603611447748*^9}},
  ExpressionUUID->"fcb30d17-b945-428d-9672-e67cb04287c0"],
 " and ",
 Cell[BoxData[
  RowBox[{
   FormBox[
    SuperscriptBox["y", "2"],
    TraditionalForm], " ", "=", " ", 
   RowBox[{
    FormBox[
     SuperscriptBox["x", "3"],
     TraditionalForm], " ", "\[Minus]", " ", 
    RowBox[{"324", "x"}]}]}]],
  CellChangeTimes->{{3.999746137883525*^9, 3.999746140309062*^9}, 
    3.999747944841783*^9, {3.999748096791851*^9, 3.999748143140012*^9}, {
    3.9997483577714043`*^9, 3.999748384378436*^9}, {3.9997484503152647`*^9, 
    3.999748461955057*^9}, {4.002603596470834*^9, 4.002603611447748*^9}},
  ExpressionUUID->"e7de68a6-04ca-4b21-bb1d-dc0fa86a44f5"],
 " are the correct short Weierstrass form because according to their \
j-invariant they are isomorphic with the same group structure."
}], "Text",
 CellChangeTimes->{{3.999746137883525*^9, 3.999746140309062*^9}, 
   3.999747944841783*^9, {3.999748096791851*^9, 3.999748119199276*^9}, {
   3.999748155439068*^9, 3.999748158815062*^9}, {3.999748471498342*^9, 
   3.999748474730439*^9}, {4.00260378902146*^9, 4.002603822674211*^9}, {
   4.003469225722904*^9, 
   4.003469269038707*^9}},ExpressionUUID->"23dc9e71-ccec-4376-8aca-\
3017c9d15ebf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example (2.3)", "Subsection",
 CellChangeTimes->{{3.999748479978301*^9, 3.9997484902181177`*^9}, {
   3.9997485267266607`*^9, 3.999748527989026*^9}, 
   4.002680365325686*^9},ExpressionUUID->"c63ced1c-ecfe-4f2d-8598-\
94e96dc5be85"],

Cell[TextData[{
 "In this example, Intersection of Two Quadratic Surfaces yields this \
equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["r", "2"], "=", 
    RowBox[{
     SuperscriptBox["m", "4"], "+", 
     SuperscriptBox["m", "3"], "+", 
     RowBox[{"2", 
      SuperscriptBox["m", "2"]}], "-", "m", "+", "1"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5ec7b990-684b-445a-8808-2f5a27df5d90"],
 " which is an elliptic curve in the quartic form with a=1, b=1, c=2, d=-1, \
and e=1. The formulas then change this curve to the\ngeneralized Weierstrass \
equation ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["y", "2"], "-", "xy", "+", 
     RowBox[{"2", "y"}]}], "=", 
    RowBox[{
     SuperscriptBox["x", "3"], "+", 
     RowBox[{
      FractionBox["7", "4"], 
      SuperscriptBox["x", "2"]}], "-", 
     RowBox[{"4", "x"}], "-", "7"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ef1197da-a0b6-4b94-bab5-069c1691a134"],
 ". Completing the square yields ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["y", "2"], "=", 
    RowBox[{
     SuperscriptBox["x", "3"], "+", 
     RowBox[{"2", 
      SuperscriptBox["x", "2"]}], "-", 
     RowBox[{"5", "x"}], "-", "6."}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a1f4fad7-7e17-4556-b715-2162e3a06a3a"]
}], "Text",
 CellChangeTimes->{{3.999748578771405*^9, 
  3.9997487424948053`*^9}},ExpressionUUID->"cd69883c-a546-448c-abba-\
414e64fa13ea"],

